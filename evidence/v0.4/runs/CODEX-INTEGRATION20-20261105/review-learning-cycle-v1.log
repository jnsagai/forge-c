            if same_scope and lesson["state"] == "VALIDATED":
                return {"capa_id": cid, "lesson_id": lid, "state": "VALIDATED", "created": False}
            if same_scope:
                raise Refused("DSP_LESSON_REQUIRES_REVIEW")
