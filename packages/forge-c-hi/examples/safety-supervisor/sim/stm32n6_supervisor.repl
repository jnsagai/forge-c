// Combined Cortex-M55 platform for the Safety Supervisor demo. NOT a full STM32N6 model: Renode's own F7/F2 models
// stand in for USART, GPIO and CRC at the STM32N6 secure addresses; watchdogs, reset flags and TIM2 are HiStm32n6Watchdogs.cs.
cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m55"
    nvic: nvic
    PerformanceInMips: 50   // assumption of 4 clock cycles per instruction at 200 MHz (CON-SUP-167), not a measurement

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    systickFrequency: 200000000
    -> cpu@0

axisram: Memory.MappedMemory @ sysbus 0x34000000
    size: 0x270000   // up to the end of AXISRAM3; retention on the device is not modelled

rcc: Timers.HiRcc @ sysbus 0x56028000

iwdg: Timers.HiIwdg @ sysbus 0x56004800
    rcc: rcc
    frequency: 32000

wwdg: Timers.HiWwdg @ sysbus 0x50002C00
    rcc: rcc
    frequency: 50000000

tim2: Timers.HiTimer @ sysbus 0x50000000
    frequency: 200000000
    IRQ -> nvic@116   // RM0486 section 24.1.2

usart1: UART.STM32F7_USART @ sysbus 0x52001000
    frequency: 200000000
    IRQ -> nvic@159   // RM0486 section 24.1.2

gpioa: GPIOPort.STM32_GPIOPort @ sysbus <0x56020000, +0x400>

crc: CRC.STM32_CRC @ sysbus 0x56024C00
    series: STM32Series.F0
    configurablePoly: true
