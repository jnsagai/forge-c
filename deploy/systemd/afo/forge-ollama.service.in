# Forge-C local Ollama (:11435, models on the data volume). Rendered by scripts/afo_services.sh. AFO-T007.
# Owner rule 2026-10-16: no local Qwen work orders; the unit exists for the local stack and stays disabled unless enabled.
[Unit]
Description=Forge-C Ollama 0.34.0 (:11435)
StartLimitIntervalSec=600
StartLimitBurst=5
RequiresMountsFor=@DATA@

[Service]
Type=exec
ExecStart=@DATA@/ollama-0.34.0/bin/ollama serve
Environment=OLLAMA_HOST=127.0.0.1:11435
Environment=OLLAMA_MODELS=@DATA@/ollama-models
Environment=OLLAMA_CONTEXT_LENGTH=24576
Environment=OLLAMA_FLASH_ATTENTION=1
Environment=OLLAMA_KV_CACHE_TYPE=q8_0
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
UMask=0077
Environment=FORGE_REPO_ROOT=@REPO@
Environment=FORGE_DATA_ROOT=@DATA@
Environment=FORGE_STATE_DIR=@STATE@
Environment=PYTHONPATH=@REPO@/factory/python
Environment=PATH=@PATH@
ExecStartPre=@VENV@/bin/python -m forge_factory.afo.host preflight

[Install]
WantedBy=default.target
