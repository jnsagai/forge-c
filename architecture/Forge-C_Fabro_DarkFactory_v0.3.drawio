a8;fontColor=#18876f;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1713" y="558" width="810" height="123" as="geometry"/></mxCell><mxCell id="fail" value="FAIL&lt;br/&gt;Open SUP.9 finding with ownership, severity, evidence and closure test" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff0f1;strokeColor=#df9ba5;fontColor=#b83d52;fontSize=19;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="612" y="558" width="981" height="123" as="geometry"/></mxCell><mxCell id="to_pass" value="ALL ITEMS PASS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#18876f;strokeWidth=3;endArrow=block;endFill=1;fontFamily=Arial;fontSize=15;fontColor=#18876f;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="ins_4" target="pass" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="to_fail" value="BLOCKED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b83d52;strokeWidth=3;endArrow=block;endFill=1;fontFamily=Arial;fontSize=15;fontColor=#b83d52;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="ins_4" target="fail" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2120" y="504"/><mxPoint x="1103" y="504"/></Array></mxGeometry></mxCell><mxCell id="routing_header" value="REWORK ROUTING  —  LOCAL, UPSTREAM OR EXHAUSTED" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#0c1932;fontSize=22;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="62" y="773" width="2453" height="40" as="geometry"/></mxCell><mxCell id="local" value="LOCAL CORRECTION&lt;br/&gt;Author reworks revision&lt;br/&gt;Reruns tests + reinspection" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f1eaff;strokeColor=#b6a6e0;fontColor=#172842;fontSize=19;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="60" y="852" width="737" height="148" as="geometry"/></mxCell><mxCell id="upstream" value="UPSTREAM ROOT CAUSE&lt;br/&gt;SUP.10 impact record; reopen affected&lt;br/&gt;SWE phase and dependent reviews" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#dabb7b;fontColor=#b77b18;fontSize=19;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="913" y="852" width="770" height="148" as="geometry"/></mxCell><mxCell id="exhausted" value="MAX RETRIES / NO PROGRESS&lt;br/&gt;Stop affected phase; retain open findings&lt;br/&gt;Invoke BLOCKED package path" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff0f1;strokeColor=#df9ba5;fontColor=#b83d52;fontSize=19;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1800" y="852" width="732" height="148" as="geometry"/></mxCell><mxCell id="fail_local" value="LOCAL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b83d52;strokeWidth=2.6;endArrow=block;endFill=1;fontFamily=Arial;fontSize=15;fontColor=#b83d52;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="fail" target="local" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="810" y="746"/><mxPoint x="417" y="746"/></Array></mxGeometry></mxCell><mxCell id="fail_upstream" value="UPSTREAM" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b77b18;strokeWidth=2.6;endArrow=block;endFill=1;fontFamily=Arial;fontSize=15;fontColor=#b77b18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="fail" target="upstream" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1280" y="746"/></Array></mxGeometry></mxCell><mxCell id="fail_exhausted" value="EXHAUSTED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b83d52;strokeWidth=2.6;endArrow=block;endFill=1;fontFamily=Arial;fontSize=15;fontColor=#b83d52;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="fail" target="exhausted" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1700" y="751"/><mxPoint x="2166" y="751"/></Array></mxGeometry></mxCell><mxCell id="loop_local" value="REINSPECT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b83d52;strokeWidth=3;endArrow=block;endFill=1;fontFamily=Arial;fontSize=15;fontColor=#b83d52;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;dashPattern=7 5;" edge="1" source="local" target="ins_0" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="36" y="908"/><mxPoint x="36" y="360"/></Array></mxGeometry></mxCell><mxCell id="loop_upstream" value="IMPACT / REBASELINE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b77b18;strokeWidth=2.6;endArrow=block;endFill=1;fontFamily=Arial;fontSize=15;fontColor=#b77b18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;dashed=1;dashPattern=7 5;" edge="1" source="upstream" target="ins_0" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="840" y="1050"/><mxPoint x="27" y="1050"/><mxPoint x="27" y="381"/></Array></mxGeometry></mxCell><mxCell id="rm_terminal" value="AUTONOMOUS TERMINAL PATH&lt;br/&gt;Release Manager assembles BLOCKED evidence package; no human interrupt inside run." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=#d898a4;fontColor=#b83d52;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1602" y="1094" width="929" height="107" as="geometry"/></mxCell><mxCell id="exhaust_to_rm" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b83d52;strokeWidth=3;endArrow=block;endFill=1;fontFamily=Arial;fontSize=15;fontColor=#b83d52;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="exhausted" target="rm_terminal" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="rules" value="DETERMINISTIC RULES&lt;br/&gt;&lt;br/&gt;• Author ID and inspector ID must differ; reviewers cannot edit authorship artefacts.&lt;br/&gt;• Required checklist items require explicit evidence and verdicts; missing ⇒ FAIL.&lt;br/&gt;• Revisions change baseline hashes; stale inspections must be repeated.&lt;br/&gt;• Critical/major findings remain blocking; no automated safety waiver.&lt;br/&gt;• Retry budget exhausted ⇒ BLOCKED, still package every available item.&lt;br/&gt;• Organizational independence and safety authorization are reviewed offline." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=#d3ddeb;fontColor=#172842;fontSize=18;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=2;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="62" y="1249" width="1192" height="315" as="geometry"/></mxCell><mxCell id="inspection_records" value="REQUIRED INSPECTION EVIDENCE&lt;br/&gt;&lt;br/&gt;INS-ASG: author/reviewer assignment&lt;br/&gt;INS-BASE: frozen workproduct IDs + SHA256&lt;br/&gt;INS-CHK: versioned phase checklist&lt;br/&gt;INS-REC: evidence-backed verdicts&lt;br/&gt;INS-FND: defects, severity, owner and closure tests&lt;br/&gt;INS-IMP: upstream impact / invalidated baselines&lt;br/&gt;INS-CLOSE: reinspection + closure result" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=#d3ddeb;fontColor=#172842;fontSize=18;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=2;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1331" y="1249" width="1200" height="315" as="geometry"/></mxCell><mxCell id="p5_footer" value="Formal AI inspections create review evidence; they do not substitute for organizational independence, qualified tool assessment or human safety decisions." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#546781;fontSize=17;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="54" y="1612" width="2500" height="37" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="06 SWE checklist catalogue" id="forge-c-0.3-p6"><mxGraphModel dx="1800" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2580" pageHeight="1325" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="page_background" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f4f7fb;strokeColor=#f4f7fb;fontColor=#172842;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2580" height="1325" as="geometry"/></mxCell><mxCell id="navy_header" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0c1932;strokeColor=#0c1932;fontColor=#172842;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2580" height="159" as="geometry"/></mxCell><mxCell id="header_tag" value="INSPECTION / CHECKLIST INDEX" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#9fbaeb;fontSize=17;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="58" y="21" width="2480" height="25" as="geometry"/></mxCell><mxCell id="header_title" value="Six separate inspection agents; phase-specific checklists are versioned engineering inputs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#ffffff;fontSize=38;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="55" y="56" width="2480" height="54" as="geometry"/></mxCell><mxCell id="header_sub" value="Open-source HAL/low-level-driver factory  |  process design  |  editable architecture" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#d5e2f7;fontSize=18;fontFamily=Arial;align=left;verticalAlign