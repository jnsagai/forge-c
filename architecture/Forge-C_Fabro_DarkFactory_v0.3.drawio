acingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="60" y="289" width="483" height="147" as="geometry"/></mxCell><mxCell id="ins_1" value="ASSIGN INSPECTOR&lt;br/&gt;Different agent identity&lt;br/&gt;Fresh isolated context" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#a2bee2;fontColor=#172842;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="571" y="289" width="483" height="147" as="geometry"/></mxCell><mxCell id="inse_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3378bf;strokeWidth=3;endArrow=block;endFill=1;fontFamily=Arial;fontSize=15;fontColor=#3378bf;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="ins_0" target="ins_1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ins_2" value="INSPECT&lt;br/&gt;Run checklist&lt;br/&gt;Evidence for every required item" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#a2bee2;fontColor=#172842;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1082" y="289" width="483" height="147" as="geometry"/></mxCell><mxCell id="inse_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3378bf;strokeWidth=3;endArrow=block;endFill=1;fontFamily=Arial;fontSize=15;fontColor=#3378bf;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="ins_1" target="ins_2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ins_3" value="RECORD&lt;br/