e=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="74" y="329" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_0_1" value="SWE1-02  Requirements are atomic, consistent, feasible and objectively verifiable." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="74" y="378" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_0_2" value="SWE1-03  Failure handling, reset/startup behavior and safe states are specified." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="74" y="427" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_0_3" value="SWE1-04  Flash/RAM/stack/CPU/timing constraints are explicit and measurable." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="74" y="476" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_0_4" value="SWE1-05  Bidirectional upstream-to-SWE.1 trace and coverage gaps are recorded." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="74" y="525" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_0_5" value="SWE1-06  Verification criteria and unresolved ambiguities are documented." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="74" y="574" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_footer_0" value="Every failed required check → finding ID → owner → fix → re-inspection" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#b83d52;fontSize=14;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="77" y="626" width="754" height="24" as="geometry"/></mxCell><mxCell id="c_bg_1" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d3ddeb;fontColor=#172842;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="898" y="240" width="806" height="419" as="geometry"/></mxCell><mxCell id="c_hd_1" value="SWE.2  ·  SOFTWARE ARCHITECTURE" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#193253;strokeColor=#193253;fontColor=#ffffff;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="914" y="256" width="774" height="55" as="geometry"/></mxCell><mxCell id="c_1_0" value="SWE2-01  Software components and interfaces cover all SWE.1 requirements." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="918" y="329" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_1_1" value="SWE2-02  Register ownership, volatile access, RMW, clocks and reset semantics are defined." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="918" y="378" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_1_2" value="SWE2-03  Concurrency, ISR synchronization, scheduling and reentrancy are addressed." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="918" y="427" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_1_3" value="SWE2-04  Safety mechanisms, degraded states and architecture dependencies are defined." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="918" y="476" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_1_4" value="SWE2-05  Memory/time budgets are allocated and justified across components." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="918" y="525" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_1_5" value="SWE2-06  Architecture decisions and bidirectional SWE.1 trace are consistent." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="918" y="574" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_footer_1" value="Every failed required check → finding ID → owner → fix → re-inspection" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#b83d52;fontSize=14;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="921" y="626" width="754" height="24" as="geometry"/></mxCell><mxCell id="c_bg_2" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d3ddeb;fontColor=#172842;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1742" y="240" width="806" height="419" as="geometry"/></mxCell><mxCell id="c_hd_2" value="SWE.3  ·  DETAILED DESIGN &amp; C/H" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#193253;strokeColor=#193253;fontColor=#ffffff;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1758" y="256" width="774" height="55" as="geometry"/></mxCell><mxCell id="c_2_0" value="SWE3-01  Detailed design and unit-level APIs/interfaces match the software architecture." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1762" y="329" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_2_1" value="SWE3-02  C code handles register access, volatile, bounds, initialization and RMW safely." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1762" y="378" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_2_2" value="SWE3-03  ISR/concurrency, interrupts, timing and error propagation are bounded." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1762" y="427" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_2_3" value="SWE3-04  MISRA C coverage/deviations and static-analysis findings are recorded." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1762" y="476" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_2_4" value="SWE3-05  No heap where prohibited; stack/Flash/RAM impacts are measured or budgeted." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1762" y="525" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_2_5" value="SWE3-06  Units and source match design, with change/trace provenance." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1762" y="574" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_footer_2" value="Every failed required check → finding ID → owner → fix → re-inspection" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#b83d52;fontSize=14;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1765" y="626" width="754" height="24" as="geometry"/></mxCell><mxCell id="c_bg_3" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d3ddeb;fontColor=#172842;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="54" y="701" width="806" height="419" as="geometry"/></mxCell><mxCell id="c_hd_3" value="SWE.4  ·  UNIT VERIFICATION" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#193253;strokeColor=#193253;fontColor=#ffffff;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="70" y="717" width="774" height="55" as="geometry"/></mxCell><mxCell id="c_3_0" value="SWE4-01  Verification measures, environment, entry/exit criteria and regression are defined." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="74" y="790" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_3_1" value="SWE4-02  All units have appropriate positive, negative, boundary and error tests." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="74" y="839" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_3_2" value="SWE4-03  Mock register semantics and hardware side effects are assessed for fidelity." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="74" y="888" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_3_3" value="SWE4-04  Static-analysis and coding-rule gaps receive review or deviations." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="74" y="937" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_3_4" value="SWE4-05  Coverage goals and structural coverage reports are linked to actual results." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="74" y="986" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_3_5" value="SWE4-06  Unit/design/test/result traceability, reproducible logs and findings exist." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="74" y="1035" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_footer_3" value="Every failed required check → finding ID → owner → fix → re-inspection" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#b83d52;fontSize=14;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="77" y="1087" width="754" height="24" as="geometry"/></mxCell><mxCell id="c_bg_4" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d3ddeb;fontColor=#172842;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="898" y="701" width="806" height="419" as="geometry"/></mxCell><mxCell id="c_hd_4" value="SWE.5  ·  COMPONENT &amp; INTEGRATION" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#193253;strokeColor=#193253;fontColor=#ffffff;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="914" y="717" width="774" height="55" as="geometry"/></mxCell><mxCell id="c_4_0" value="SWE5-01  Component behavior and software integration verification are both planned." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="918" y="790" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_4_1" value="SWE5-02  Sequence of integration and target interfaces match the architecture." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="918" y="839" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_4_2" value="SWE5-03  Inter-component resource, clock, reset and interrupt interactions are tested." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="918" y="888" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_4_3" value="SWE5-04  Robustness, fault propagation and timing/resource budgets are checked." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="918" y="937" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_4_4" value="SWE5-05  Component/integration measures map to architecture, results and regressions." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="918" y="986" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_4_5" value="SWE5-06  Simulation vs target evidence limitations are explicit and unresolved defects tracked." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="918" y="1035" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_footer_4" value="Every failed required check → finding ID → owner → fix → re-inspection" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#b83d52;fontSize=14;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="921" y="1087" width="754" height="24" as="geometry"/></mxCell><mxCell id="c_bg_5" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d3ddeb;fontColor=#172842;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1742" y="701" width="806" height="419" as="geometry"/></mxCell><mxCell id="c_hd_5" value="SWE.6  ·  SOFTWARE VERIFICATION" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#193253;strokeColor=#193253;fontColor=#ffffff;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1758" y="717" width="774" height="55" as="geometry"/></mxCell><mxCell id="c_5_0" value="SWE6-01  Integrated software is verified against approved SWE.1 requirements." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1762" y="790" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_5_1" value="SWE6-02  Verification measures and selection cover normal, boundary and failure behavior." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1762" y="839" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_5_2" value="SWE6-03  Safety functions, fault responses and target-specific constraints are addressed." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1762" y="888" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_5_3" value="SWE6-04  Requirements → measures → results traceability is complete and consistent." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1762" y="937" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_5_4" value="SWE6-05  Pass/fail criteria, actual results, regressions and defect status are auditable." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1762" y="986" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_5_5" value="SWE6-06  Final verification summary states unverified hardware/ASIL gaps accurately." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1762" y="1035" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_footer_5" value="Every failed required check → finding ID → owner → fix → re-inspection" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#b83d52;fontSize=14;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1765" y="1087" width="754" height="24" as="geometry"/></mxCell><mxCell id="p6_foot" value="See companion YAML files for stable IDs, required/optional flags, evidence rules and severity defaults. These are project checklists, not proprietary MISRA rule reproductions." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#546781;fontSize=17;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyl