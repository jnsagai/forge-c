idth=0;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="55" y="55" width="2470" height="55" as="geometry"/></mxCell><mxCell id="header_sub" value="A deterministic packager hashes evidence and generates the bundle; missing evidence is explicit, never fabricated." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#d5e2f7;fontSize=18;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="58" y="115" width="2490" height="30" as="geometry"/></mxCell><mxCell id="status" value="AUTONOMOUS OUTPUT" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#193253;strokeColor=#47688e;fontColor=#dce8f8;fontSize=16;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="2140" y="26" width="400" height="47" as="geometry"/></mxCell><mxCell id="foot_band" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d3ddeb;fontColor=#172842;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="0" y="1545" width="2600" height="65" as="geometry"/></mxCell><mxCell id="tree_title" value="REVIEW PACKAGE: forge-c-&amp;lt;run-id&amp;gt;-review.zip" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#0c1932;fontSize=24;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="62" y="196" width="2440" height="42" as="geometry"/></mxCell><mxCell id="pkg_cat_0" value="01 SOFTWARE&lt;br/&gt;software/src + include&lt;br/&gt;software/build/ELF + map&lt;br/&gt;linker + compiler options" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#94b9e0;fontColor=#172842;fontSize=19;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="56" y="310" width="599" height="231" as="geometry"/></mxCell><mxCell id="pkg_cat_1" value="02 SWE.1–3&lt;br/&gt;software requirements&lt;br/&gt;architecture / interfaces&lt;br/&gt;detailed design + code mapping" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#94b9e0;fontColor=#172842;fontSize=19;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="696" y="310" width="599" height="231" as="geometry"/></mxCell><mxCell id="pkg_cat_2" value="03 SWE.4–6&lt;br/&gt;unit verification evidence&lt;br/&gt;component + integration&lt;br/&gt;software verification results" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#94b9e0;fontColor=#172842;fontSize=19;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1336" y="310" width="599" height="231" as="geometry"/></mxCell><mxCell id="pkg_cat_3" value="04 SAFETY&lt;br/&gt;allocated safety requirements&lt;br/&gt;safety analysis / deviations&lt;br/&gt;gaps &amp;amp; target limitations" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=#d3ddeb;fontColor=#172842;fontSize=19;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1976" y="310" width="599" height="231" as="geometry"/></mxCell><mxCell id="pkg_cat_4" value="05 VERIFICATION&lt;br/&gt;static/MISRA rule coverage&lt;br/&gt;unit/integration test logs&lt;br/&gt;LLVM coverage / footprint" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#94b9e0;fontColor=#172842;fontSize=19;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="56" y="616" width="599" height="231" as="geometry"/></mxCell><mxCell id="pkg_cat_5" value="06 INSPECTIONS&lt;br/&gt;all six checklists + versions&lt;br/&gt;findings + closures&lt;br/&gt;upstream impact history" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=#d3ddeb;fontColor=#172842;fontSize=19;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="696" y="616" width="599" height="231" as="geometry"/></mxCell><mxCell id="pkg_cat_6" value="07 TRACE + SCM&lt;br/&gt;req↔arch↔unit↔test↔result&lt;br/&gt;SUP.1 QA / SUP.8 CM / SUP.9 defects&lt;br/&gt;SUP.10 change records" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=#d3ddeb;fontColor=#172842;fontSize=19;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1336" y="616" width="599" height="231" as="geometry"/></mxCell><mxCell id="pkg_cat_7" value="08 RELEASE META&lt;br/&gt;manifest.json + SHA256SUMS&lt;br/&gt;SBOM / toolchain versions&lt;br/&gt;status, gap report, handover" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=#d3ddeb;fontColor=#172842;fontSize=19;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1976" y="616" width="599" height="231" as="geometry"/></mxCell><mxCell id="contract" value="PACKAGING INVARIANTS&lt;br/&gt;&lt;br/&gt;• Every file indexed with path, size and SHA-256; archive can be checked offline.&lt;br/&gt;• Missing required artifact stays visible in a machine-readable gap report.&lt;br/&gt;• The quality result is derived from deterministic policy checks, not an LLM assertion.&lt;br/&gt;• An exhausted or unsuccessful run produces the same package structure, status BLOCKED." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=#d3ddeb;fontColor=#172842;fontSize=18;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=2;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="55" y="967" width="1510" height="271" as="geometry"/></mxCell><mxCell id="statuses" value="ALLOWED MACHINE STATUSES&lt;br/&gt;&lt;br/&gt;READY_FOR_OFFLINE_REVIEW&lt;br/&gt;BLOCKED&lt;br/&gt;&lt;br/&gt;Neither means approved, certified, released, or safe to deploy." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#d9ba7c;fontColor=#b77b18;fontSize=19;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1645" y="967" width="901" height="271" as="geometry"/></mxCell><mxCell id="external_line" value="DARK FACTORY BOUNDARY: archive generation and integrity checks complete" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#193253;strokeColor=#193253;fontColor=#ffffff;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="53" y="1301" width="2493" height="65" as="geometry"/></mxCell><mxCell id="offline_review" value="OFFLINE HUMAN REVIEW &amp; DISPOSITION&lt;br/&gt;Review artifact completeness and correctness, independently validate critical evidence, assess ASIL B suitability, accept or reject findings and authorize release only through the organization's safety process." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#dabb7b;fontColor=#b77b18;fontSize=19;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;dashed=1;dashPattern=7 5;" vertex="1" parent="1"><mxGeometry x="225" y="1406" width="2149" height="115" as="geometry"/></mxCell><mxCell id="p7_footer" value="The model cannot self-approve MISRA compliance, ISO 26262 qualification, or ASPICE capability. Those remain externally assessed." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#546781;fontSize=17;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="58" y="1561" width="2470" height="33" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
