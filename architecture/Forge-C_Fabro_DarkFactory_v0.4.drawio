<diagram name="05 Inspection protocol" id="forge-c-0.3-p5"><mxGraphModel dx="2000" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2590" pageHeight="1665" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="page_background" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f4f7fb;strokeColor=#f4f7fb;fontColor=#172842;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2590" height="1665" as="geometry"/></mxCell><mxCell id="navy_header" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0c1932;strokeColor=#0c1932;fontColor=#172842;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2590" height="160" as="geometry"/></mxCell><mxCell id="header_tag" value="CHECKLIST-DRIVEN REVIEW PROTOCOL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#9fbaeb;fontSize=17;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="55" y="21" width="2480" height="25" as="geometry"/></mxCell><mxCell id="header_title" value="Independent agent inspection with bounded autonomous rework" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#ffffff;fontSize=37;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="55" y="55" width="2460" height="55" as="geometry"/></mxCell><mxCell id="header_sub" value="Identical protocol applied separately to SWE.1, SWE.2, SWE.3, SWE.4, SWE.5 and SWE.6." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#d5e2f7;fontSize=18;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="58" y="115" width="2480" height="30" as="geometry"/></mxCell><mxCell id="status" value="PROPOSED · UNATTENDED" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#193253;strokeColor=#47688e;fontColor=#dce8f8;fontSize=16;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="2130" y="26" width="400" height="47" as="geometry"/></mxCell><mxCell id="foot_band" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d3ddeb;fontColor=#172842;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="0" y="1600" width="2590" height="65" as="geometry"/></mxCell><mxCell id="inspect_header" value="ENTRY + FORMAL INSPECTION" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#0c1932;fontSize=22;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="58" y="191" width="2480" height="43" as="geometry"/></mxCell><mxCell id="ins_0" value="FREEZE AUTHOR WP&lt;br/&gt;Revision + SHA256&lt;br/&gt;Upstream reference baseline" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f1eaff;strokeColor=#b5a3e1;fontColor=#172842;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="60" y="289" width="483" height="147" as="geometry"/></mxCell><mxCell id="ins_1" value="ASSIGN INSPECTOR&lt;br/&gt;Different agent identity&lt;br/&gt;Fresh isolated context" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#a2bee2;fontColor=#172842;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="571" y="289" width="483" height="147" as="geometry"/></mxCell><mxCell id="inse_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3378bf;strokeWidth=3;endArrow=block;endFill=1;fontFamily=Arial;fontSize=15;fontColor=#3378bf;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="ins_0" target="ins_1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ins_2" value="INSPECT&lt;br/&gt;Run checklist&lt;br/&gt;Evidence for every required item" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#a2bee2;fontColor=#172842;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1082" y="289" width="483" height="147" as="geometry"/></mxCell><mxCell id="inse_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3378bf;strokeWidth=3;endArrow=block;endFill=1;fontFamily=Arial;fontSize=15;fontColor=#3378bf;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="ins_1" target="ins_2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ins_3" value="RECORD&lt;br/&gt;Verdict + precise finding&lt;br/&gt;Affected workproduct &amp; owner" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=#d3ddeb;fontColor=#172842;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1593" y="289" width="483" height="147" as="geometry"/></mxCell><mxCell id="inse_3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3378bf;strokeWidth=3;endArrow=block;endFill=1;fontFamily=Arial;fontSize=15;fontColor=#3378bf;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="ins_2" target="ins_3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ins_4" value="CHECKLIST GATE&lt;br/&gt;Machine validates findings&lt;br/&gt;Required items + traceability" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#d9b878;fontColor=#172842;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="2104" y="289" width="483" height="147" as="geometry"/></mxCell><mxCell id="inse_4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3378bf;strokeWidth=3;endArrow=block;endFill=1;fontFamily=Arial;fontSize=15;fontColor=#3378bf;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="ins_3" target="ins_4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pass" value="PASS&lt;br/&gt;Freeze review record and phase baseline&lt;br/&gt;Proceed to next SWE phase" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e9f8f1;strokeColor=#73bba8;fontColor=#18876f;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1713" y="558" width="810" height="123" as="geometry"/></mxCell><mxCell id="fail" value="FAIL&lt;br/&gt;Open SUP.9 finding with ownership, severity, evidence and closure test" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff0f1;strokeColor=#df9ba5;fontColor=#b83d52;fontSize=19;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="612" y="558" width="981" height="123" as="geometry"/></mxCell><mxCell id="to_pass" value="ALL ITEMS PASS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#18876f;strokeWidth=3;endArrow=block;endFill=1;fontFamily=Arial;fontSize=15;fontColor=#18876f;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="ins_4" target="pass" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="to_fail" value="BLOCKED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b83d52;strokeWidth=3;endArrow=block;endFill=1;fontFamily=Arial;fontSize=15;fontColor=#b83d52;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="ins_4" target="fail" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2120" y="504"/><mxPoint x="1103" y="504"/></Array></mxGeometry></mxCell><mxCell id="routing_header" value="REWORK ROUTING  —  LOCAL, UPSTREAM OR EXHAUSTED" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#0c1932;fontSize=22;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="62" y="773" width="2453" height="40" as="geometry"/></mxCell><mxCell id="local" value="LOCAL CORRECTION&lt;br/&gt;Author reworks revision&lt;br/&gt;Reruns tests + reinspection" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f1eaff;strokeColor=#b6a6e0;fontColor=#172842;fontSize=19;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="60" y="852" width="737" height="148" as="geometry"/></mxCell><mxCell id="upstream" value="UPSTREAM ROOT CAUSE&lt;br/&gt;SUP.10 impact record; reopen affected&lt;br/&gt;SWE phase and dependent reviews" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#dabb7b;fontColor=#b77b18;fontSize=19;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="913" y="852" width="770" height="148" as="geometry"/></mxCell><mxCell id="exhausted" value="MAX RETRIES / NO PROGRESS&lt;br/&gt;Stop affected phase; retain open findings&lt;br/&gt;Invoke BLOCKED package path" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff0f1;strokeColor=#df9ba5;fontColor=#b83d52;fontSize=19;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1800" y="852" width="732" height="148" as="geometry"/></mxCell><mxCell id="fail_local" value="LOCAL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b83d52;strokeWidth=2.6;endArrow=block;endFill=1;fontFamily=Arial;fontSize=15;fontColor=#b83d52;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="fail" target="local" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="810" y="746"/><mxPoint x="417" y="746"/></Array></mxGeometry></mxCell><mxCell id="fail_upstream" value="UPSTREAM" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b77b18;strokeWidth=2.6;endArrow=block;endFill=1;fontFamily=Arial;fontSize=15;fontColor=#b77b18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="fail" target="upstream" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1280" y="746"/></Array></mxGeometry></mxCell><mxCell id="fail_exhausted" value="EXHAUSTED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b83d52;strokeWidth=2.6;endArrow=block;endFill=1;fontFamily=Arial;fontSize=15;fontColor=#b83d52;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="fail" target="exhausted" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1700" y="751"/><mxPoint x="2166" y="751"/></Array></mxGeometry></mxCell><mxCell id="loop_local" value="REINSPECT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b83d52;strokeWidth=3;endArrow=block;endFill=1;fontFamily=Arial;fontSize=15;fontColor=#b83d52;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;dashPattern=7 5;" edge="1" source="local" target="ins_0" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="36" y="908"/><mxPoint x="36" y="360"/></Array></mxGeometry></mxCell><mxCell id="loop_upstream" value="IMPACT / REBASELINE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b77b18;strokeWidth=2.6;endArrow=block;endFill=1;fontFamily=Arial;fontSize=15;fontColor=#b77b18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;dashed=1;dashPattern=7 5;" edge="1" source="upstream" target="ins_0" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="840" y="1050"/><mxPoint x="27" y="1050"/><mxPoint x="27" y="381"/></Array></mxGeometry></mxCell><mxCell id="rm_terminal" value="AUTONOMOUS TERMINAL PATH&lt;br/&gt;Release Manager assembles BLOCKED evidence package; no human interrupt inside run." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=#d898a4;fontColor=#b83d52;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1602" y="1094" width="929" height="107" as="geometry"/></mxCell><mxCell id="exhaust_to_rm" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b83d52;strokeWidth=3;endArrow=block;endFill=1;fontFamily=Arial;fontSize=15;fontColor=#b83d52;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="exhausted" target="rm_terminal" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="rules" value="DETERMINISTIC RULES&lt;br/&gt;&lt;br/&gt;• Author ID and inspector ID must differ; reviewers cannot edit authorship artefacts.&lt;br/&gt;• Required checklist items require explicit evidence and verdicts; missing ⇒ FAIL.&lt;br/&gt;• Revisions change baseline hashes; stale inspections must be repeated.&lt;br/&gt;• Critical/major findings remain blocking; no automated safety waiver.&lt;br/&gt;• Retry budget exhausted ⇒ BLOCKED, still package every available item.&lt;br/&gt;• Organizational independence and safety authorization are reviewed offline." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=#d3ddeb;fontColor=#172842;fontSize=18;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=2;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="62" y="1249" width="1192" height="315" as="geometry"/></mxCell><mxCell id="inspection_records" value="REQUIRED INSPECTION EVIDENCE&lt;br/&gt;&lt;br/&gt;INS-ASG: author/reviewer assignment&lt;br/&gt;INS-BASE: frozen workproduct IDs + SHA256&lt;br/&gt;INS-CHK: versioned phase checklist&lt;br/&gt;INS-REC: evidence-backed verdicts&lt;br/&gt;INS-FND: defects, severity, owner and closure tests&lt;br/&gt;INS-IMP: upstream impact / invalidated baselines&lt;br/&gt;INS-CLOSE: reinspection + closure result" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=#d3ddeb;fontColor=#172842;fontSize=18;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=2;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1331" y="1249" width="1200" height="315" as="geometry"/></mxCell><mxCell id="p5_footer" value="Formal AI inspections create review evidence; they do not substitute for organizational independence, qualified tool assessment or human safety decisions." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#546781;fontSize=17;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="54" y="1612" width="2500" height="37" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="06 SWE checklist catalogue" id="forge-c-0.3-p6"><mxGraphModel dx="1800" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2580" pageHeight="1325" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="page_background" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f4f7fb;strokeColor=#f4f7fb;fontColor=#172842;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2580" height="1325" as="geometry"/></mxCell><mxCell id="navy_header" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0c1932;strokeColor=#0c1932;fontColor=#172842;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2580" height="159" as="geometry"/></mxCell><mxCell id="header_tag" value="INSPECTION / CHECKLIST INDEX" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#9fbaeb;fontSize=17;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="58" y="21" width="2480" height="25" as="geometry"/></mxCell><mxCell id="header_title" value="Six separate inspection agents; phase-specific checklists are versioned engineering inputs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#ffffff;fontSize=38;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="55" y="56" width="2480" height="54" as="geometry"/></mxCell><mxCell id="header_sub" value="Open-source HAL/low-level-driver factory  |  process design  |  editable architecture" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#d5e2f7;fontSize=18;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="58" y="114" width="2480" height="30" as="geometry"/></mxCell><mxCell id="status" value="6 × 6 REQUIRED CHECKS" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#193253;strokeColor=#48678f;fontColor=#d9e5f5;fontSize=16;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="2125" y="27" width="390" height="45" as="geometry"/></mxCell><mxCell id="foot_band" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d3ddeb;fontColor=#172842;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="0" y="1250" width="2580" height="75" as="geometry"/></mxCell><mxCell id="c_bg_0" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d3ddeb;fontColor=#172842;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="54" y="240" width="806" height="419" as="geometry"/></mxCell><mxCell id="c_hd_0" value="SWE.1  ·  SOFTWARE REQUIREMENTS" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#193253;strokeColor=#193253;fontColor=#ffffff;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="70" y="256" width="774" height="55" as="geometry"/></mxCell><mxCell id="c_0_0" value="SWE1-01  HSI and allocated software safety requirements are baselined and traceable." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="74" y="329" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_0_1" value="SWE1-02  Requirements are atomic, consistent, feasible and objectively verifiable." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="74" y="378" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_0_2" value="SWE1-03  Failure handling, reset/startup behavior and safe states are specified." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="74" y="427" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_0_3" value="SWE1-04  Flash/RAM/stack/CPU/timing constraints are explicit and measurable." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="74" y="476" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_0_4" value="SWE1-05  Bidirectional upstream-to-SWE.1 trace and coverage gaps are recorded." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="74" y="525" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_0_5" value="SWE1-06  Verification criteria and unresolved ambiguities are documented." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="74" y="574" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_footer_0" value="Every failed required check → finding ID → owner → fix → re-inspection" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#b83d52;fontSize=14;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="77" y="626" width="754" height="24" as="geometry"/></mxCell><mxCell id="c_bg_1" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d3ddeb;fontColor=#172842;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="898" y="240" width="806" height="419" as="geometry"/></mxCell><mxCell id="c_hd_1" value="SWE.2  ·  SOFTWARE ARCHITECTURE" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#193253;strokeColor=#193253;fontColor=#ffffff;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="914" y="256" width="774" height="55" as="geometry"/></mxCell><mxCell id="c_1_0" value="SWE2-01  Software components and interfaces cover all SWE.1 requirements." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="918" y="329" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_1_1" value="SWE2-02  Register ownership, volatile access, RMW, clocks and reset semantics are defined." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="918" y="378" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_1_2" value="SWE2-03  Concurrency, ISR synchronization, scheduling and reentrancy are addressed." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="918" y="427" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_1_3" value="SWE2-04  Safety mechanisms, degraded states and architecture dependencies are defined." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="918" y="476" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_1_4" value="SWE2-05  Memory/time budgets are allocated and justified across components." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="918" y="525" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_1_5" value="SWE2-06  Architecture decisions and bidirectional SWE.1 trace are consistent." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="918" y="574" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_footer_1" value="Every failed required check → finding ID → owner → fix → re-inspection" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#b83d52;fontSize=14;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="921" y="626" width="754" height="24" as="geometry"/></mxCell><mxCell id="c_bg_2" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d3ddeb;fontColor=#172842;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1742" y="240" width="806" height="419" as="geometry"/></mxCell><mxCell id="c_hd_2" value="SWE.3  ·  DETAILED DESIGN &amp; C/H" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#193253;strokeColor=#193253;fontColor=#ffffff;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1758" y="256" width="774" height="55" as="geometry"/></mxCell><mxCell id="c_2_0" value="SWE3-01  Detailed design and unit-level APIs/interfaces match the software architecture." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1762" y="329" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_2_1" value="SWE3-02  C code handles register access, volatile, bounds, initialization and RMW safely." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1762" y="378" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_2_2" value="SWE3-03  ISR/concurrency, interrupts, timing and error propagation are bounded." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1762" y="427" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_2_3" value="SWE3-04  MISRA C coverage/deviations and static-analysis findings are recorded." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1762" y="476" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_2_4" value="SWE3-05  No heap where prohibited; stack/Flash/RAM impacts are measured or budgeted." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1762" y="525" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_2_5" value="SWE3-06  Units and source match design, with change/trace provenance." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1762" y="574" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_footer_2" value="Every failed required check → finding ID → owner → fix → re-inspection" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#b83d52;fontSize=14;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1765" y="626" width="754" height="24" as="geometry"/></mxCell><mxCell id="c_bg_3" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d3ddeb;fontColor=#172842;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="54" y="701" width="806" height="419" as="geometry"/></mxCell><mxCell id="c_hd_3" value="SWE.4  ·  UNIT VERIFICATION" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#193253;strokeColor=#193253;fontColor=#ffffff;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="70" y="717" width="774" height="55" as="geometry"/></mxCell><mxCell id="c_3_0" value="SWE4-01  Verification measures, environment, entry/exit criteria and regression are defined." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="74" y="790" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_3_1" value="SWE4-02  All units have appropriate positive, negative, boundary and error tests." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="74" y="839" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_3_2" value="SWE4-03  Mock register semantics and hardware side effects are assessed for fidelity." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="74" y="888" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_3_3" value="SWE4-04  Static-analysis and coding-rule gaps receive review or deviations." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="74" y="937" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_3