 edge="1" parent="1" source="post_evidence" target="post_gate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="post_candidate" value="RELEASE MANAGER&lt;br/&gt;INPUT (candidate)&lt;br/&gt;No safety approval" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#193253;strokeColor=#193253;fontColor=#ffffff;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="2350" y="1306" width="183" height="134" as="geometry"/></mxCell><mxCell id="edge_post_3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#18876f;strokeWidth=2.7;endArrow=block;endFill=1;fontFamily=Arial;fontSize=15;fontColor=#18876f;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="post_gate" target="post_candidate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge_last_pass_to_opt" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#18876f;strokeWidth=3;endArrow=block;endFill=1;fontFamily=Arial;fontSize=15;fontColor=#18876f;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m_pass_5" target="post_opt"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2567" y="1045"/><mxPoint x="2567" y="1235"/><mxPoint x="28" y="1235"/><mxPoint x="28" y="1373"/></Array></mxGeometry></mxCell><mxCell id="post_reject" value="QUALITY GATE FAIL → register findings and reopen originating SWE phase; after retry limit → Release Manager builds BLOCKED package" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff0f1;strokeColor=#d79bab;fontColor=#b83d52;fontSize=16;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;s