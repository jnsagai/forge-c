e="Open-source HAL/low-level-driver factory  |  process design  |  editable architecture" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#d5e2f7;fontSize=18;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="58" y="114" width="2380" height="30" as="geometry"/></mxCell><mxCell id="status" value="PROPOSED · CHECKLIST-GATED" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#193253;strokeColor=#48678f;fontColor=#d9e5f5;fontSize=16;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="2025" y="27" width="390" height="45" as="geometry"/></mxCell><mxCell id="foot_band" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d3ddeb;fontColor=#172842;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="0" y="1515" width="2480" height="75" as="geometry"/></mxCell><mxCell id="p5_phase_1" value="INSPECTION ENTRY + SEPARATE ROLES" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#0c1932;fontSize=22;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="60" y="187" width="2310" height="47" as="geometry"/></mxCell><mxCell id="p5_author" value="AUTHOR FREEZES WORKPRODUCT&lt;br/&gt;Baseline ID · WP revision · content hash" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f1eaff;strokeColor=#b7a2e3;fontColor=#172842;fontSize=19;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="72" y="277" width="405" height="125" as="geometry"/></mxCell><mxCell id="p5_assign" value="FABRO ASSIGNS INSPECTOR&lt;br/&gt;Distinct agent ID / context&lt;br/&gt;No self-review" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#8eafe0;fontColor=#172842;fontSize=19;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="561" y="277" width="414" height="125" as="geometry"/></mxCell><mxCell id="p5_read" value="INDEPENDENT FORMAL INSPECTION&lt;br/&gt;Execute versioned checklist&lt;br/&gt;Cite evidence for each item" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf3ff;strokeColor=#8eafe0;fontColor=#172842;fontSize=19;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1059" y="277" width="451" height="125" as="geometry"/></mxCell><mxCell id="p5_record" value="INSPECTION RECORD&lt;br/&gt;Findings + severity + exact location&lt;br/&gt;Proposed remedy, evidence, owner" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=#d3ddeb;fontColor=#172842;fontSize=19;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1600" y="277" width="439" height="125" as="geometry"/></mxCell><mxCell id="p5_decide" value="ALL MANDATORY&lt;br/&gt;ITEMS PASS?" style="rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#c99b50;fontColor=#b77b18;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="2092" y="267" width="285" height="147" as="geometry"/></mxCell><mxCell id="p5_chain_0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7350ba;strokeWidth=3;endArrow=block;endFill=1;fontFamily=Arial;fontSize=15;fontColor=#7350ba;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5_author" target="p5_assign"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5_chain_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3378bf;strokeWidth=3;endArrow=block;endFill=1;fontFamily=Arial;fontSize=15;fontColor=#3378bf;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5_assign" target="p5_read"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5_chain_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3378bf;strokeWidth=3;endArrow=block;endFill=1;fontFamily=Arial;fontSize=15;fontColor=#3378bf;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5_read" target="p5_record"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5_chain_3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3378bf;strokeWidth=3;endArrow=block;endFill=1;fontFamily=Arial;fontSize=15;fontColor=#3378bf;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5_record" target="p5_decide"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5_accepted" value="PASS: FREEZE REVIEW RECORD + RELEASE PHASE BASELINE&lt;br/&gt;Enable next SWE stage only when findings closure and gates are checked" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e9f8f1;strokeColor=#6bbfa9;fontColor=#18876f;fontSize=19;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1649" y="536" width="725" height="104" as="geometry"/></mxCell><mxCell id="p5_decide_pass" value="PASS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#18876f;strokeWidth=3;endArrow=block;endFill=1;fontFamily=Arial;fontSize=15;fontColor=#18876f;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5_decide" target="p5_accepted"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2235" y="482"/><mxPoint x="2235" y="536"/></Array></mxGeometry></mxCell><mxCell id="p5_findings" value="FAIL: REGISTER SUP.9 FINDINGS&lt;br/&gt;Unique IDs; location; severity; impact; owner; fix verification criteria" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff0f1;strokeColor=#da93a0;fontColor=#b83d52;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1078" y="536" width="506" height="114" as="geometry"/></mxCell><mxCell id="p5_decide_fail" value="FAIL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b83d52;strokeWidth=3;endArrow=block;endFill=1;fontFamily=Arial;fontSize=15;fontColor=#b83d52;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5_decide" target="p5_findings"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2120" y="463"/><mxPoint x="2120" y="501"/><mxPoint x="1331" y="501"/></Array></mxGeometry></mxCell><mxCell id="p5_origin" value="ROOT CAUSE / CHANGE ORIGIN?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#0c1932;fontSize=22;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="69" y="741" width="2280" height="49" as="geometry"/></mxCell><mxCell id="p5_local" value="SAME-PHASE FINDING&lt;br/&gt;Author reworks WP + tests&lt;br/&gt;New revision / hash" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f1eaff;strokeColor=#b7a2e3;fontColor=#172842;fontSize=19;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="72" y="840" width="518" height="150" as="geometry"/></mxCell><mxCell id="p5_upstream" value="UPSTREAM REQUIREMENT / DESIGN DEFECT&lt;br/&gt;SUP.10 change request + impact analysis&lt;br/&gt;Reopen originating SWE phase + downstream gates" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#d5b273;fontColor=#b77b18;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="718" y="840" width="725" height="150" as="geometry"/></mxCell><mxCell id="p5_hold" value="NO PROGRESS / ITERATION LIMIT / SAFETY ISSUE&lt;br/&gt;Human moderator / safety authority triage&lt;br/&gt;HOLD until decision, no auto-waiver" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff0f1;strokeColor=#d89aa7;fontColor=#b83d52;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1628" y="840" width="748" height="150" as="geometry"/></mxCell><mxCell id="p5_route_local" value="LOCAL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b83d52;strokeWidth=3;endArrow=block;endFill=1;fontFamily=Arial;fontSize=15;fontColor=#b83d52;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5_findings" target="p5_local"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1045" y="704"/><mxPoint x="338" y="704"/></Array></mxGeometry></mxCell><mxCell id="p5_route_upstream" value="UPSTREAM" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b77b18;strokeWidth=2.7;endArrow=block;endFill=1;fontFamily=Arial;fontSize=15;fontColor=#b77b18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5_findings" target="p5_upstream"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1277" y="737"/><mxPoint x="1070" y="737"/></Array></mxGeometry></mxCell><mxCell id="p5_route_hold" value="ESCALATE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b83d52;strokeWidth=2.4;endArrow=block;endFill=1;fontFamily=Arial;fontSize=15;fontColor=#b83d52;labelBackgroundColor=#ffffff;dashed=1;dashPattern=7 5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5_findings" target="p5_hold"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1607" y="710"/><mxPoint x="1992" y="710"/></Array></mxGeometry></mxCell><mxCell id="p5_retry_local" value="REINSPECT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b83d52;strokeWidth=3;endArrow=block;endFill=1;fontFamily=Arial;fontSize=15;fontColor=#b83d52;labelBackgroundColor=#ffffff;dashed=1;dashPattern=7 5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5_local" target="p5_author"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="30" y="912"/><mxPoint x="30" y="337"/></Array></mxGeometry></mxCell><mxCell id="p5_retry_upstream" value="REBASELINE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b77b18;strokeWidth=2.6;endArrow=block;endFill=1;fontFamily=Arial;fontSize=15;fontColor=#b77b18;labelBackgroundColor=#ffffff;dashed=1;dashPattern=7 5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5_upstream" target="p5_author"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="670" y="1083"/><mxPoint x="38" y="1083"/><mxPoint x="38" y="385"/></Array></mxGeometry></mxCell><mxCell id="p5_json" value="MINIMUM INSPECTION RECORD&lt;br/&gt;&lt;br/&gt;phase • workproduct_id • revision • content_sha256&lt;br/&gt;author_agent_id • inspector_agent_id • checklist_id + version&lt;br/&gt;item_id • verdict {PASS, FAIL, NA} • rationale • evidence URI&lt;br/&gt;finding_id • severity • source_location • owner • rework_revision&lt;br/&gt;disposition • verification_result • timestamp • reviewer decision" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=#d3ddeb;fontColor=#172842;fontSize=19;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=2;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="68" y="1174" width="1160" height="291" as="geometry"/></mxCell><mxCell id="p5_rules" value="DETERMINISTIC CLOSURE POLICY&lt;br/&gt;&lt;br/&gt;• No self-review; inspector cannot alter authored artifact.&lt;br/&gt;• Mandatory checklist item missing → FAIL (not implied PASS).&lt;br/&gt;• Open critical/major finding → BLOCKED; minor needs recorded disposition.&lt;br/&gt;• Rework creates new baseline; dependent verdicts become STALE.&lt;br/&gt;• Require reinspection of changed artifacts and impacted downstream.&lt;br/&gt;• Max N repair attempts → HOLD and human triage.&lt;br/&gt;• Human safety acceptance is never delegated to an AI reviewer." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#dabb7c;fontColor=#172842;fontSize=18;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=2;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1272" y="1174" width="1108" height="291" as="geometry"/></mxCell><mxCell id="p5_note" value="Formal inspection-style protocol is a Forge-C project control; it does not by itself prove ASPICE capability or ISO 26262 compliance." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#546781;fontSize=17;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="58" y="1507" width="2375" height="38" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="06 SWE checklist catalogue" id="forge-c-0.2-p6"><mxGraphModel dx="1800" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2580" pageHeight="1325" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="page_background" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f4f7fb;strokeColor=#f4f7fb;fontColor=#172842;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2580" height="1325" as="geometry"/></mxCell><mxCell id="navy_header" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0c1932;strokeColor=#0c1932;fontColor=#172842;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2580" height="159" as="geometry"/></mxCell><mxCell id="header_tag" value="INSPECTION / CHECKLIST INDEX" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#9fbaeb;fontSize=17;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="58" y="21" width="2480" height="25" as="geometry"/></mxCell><mxCell id="header_title" value="Six separate inspection agents; phase-specific checklists are versioned engineering inputs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#ffffff;fontSize=38;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="55" y="56" width="2480" height="54" as="geometry"/></mxCell><mxCell id="header_sub" value="Open-source HAL/low-level-driver factory  |  process design  |  editable architecture" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#d5e2f7;fontSize=18;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="58" y="114" width="2480" height="30" as="geometry"/></mxCell><mxCell id="status" value="6 × 6 REQUIRED CHECKS" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#193253;strokeColor=#48678f;fontColor=#d9e5f5;fontSize=16;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="2125" y="27" width="390" height="45" as="geometry"/></mxCell><mxCell id="foot_band" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d3ddeb;fontColor=#172842;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="0" y="1250" width="2580" height="75" as="geometry"/></mxCell><mxCell id="c_bg_0" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d3ddeb;fontColor=#172842;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="54" y="240" width="806" height="419" as="geometry"/></mxCell><mxCell id="c_hd_0" value="SWE.1  ·  SOFTWARE REQUIREMENTS" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#193253;strokeColor=#193253;fontColor=#ffffff;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="70" y="256" width="774" height="55" as="geometry"/></mxCell><mxCell id="c_0_0" value="SWE1-01  HSI and allocated software safety requirements are baselined and traceable." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="74" y="329" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_0_1" value="SWE1-02  Requirements are atomic, consistent, feasible and objectively verifiable." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="74" y="378" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_0_2" value="SWE1-03  Failure handling, reset/startup behavior and safe states are specified." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="74" y="427" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_0_3" value="SWE1-04  Flash/RAM/stack/CPU/timing constraints are explicit and measurable." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="74" y="476" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_0_4" value="SWE1-05  Bidirectional upstream-to-SWE.1 trace and coverage gaps are recorded." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="74" y="525" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_0_5" value="SWE1-06  Verification criteria and unresolved ambiguities are documented." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="74" y="574" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_footer_0" value="Every failed required check → finding ID → owner → fix → re-inspection" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#b83d52;fontSize=14;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="77" y="626" width="754" height="24" as="geometry"/></mxCell><mxCell id="c_bg_1" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d3ddeb;fontColor=#172842;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="898" y="240" width="806" height="419" as="geometry"/></mxCell><mxCell id="c_hd_1" value="SWE.2  ·  SOFTWARE ARCHITECTURE" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#193253;strokeColor=#193253;fontColor=#ffffff;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="914" y="256" width="774" height="55" as="geometry"/></mxCell><mxCell id="c_1_0" value="SWE2-01  Software components and interfaces cover all SWE.1 requirements." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="918" y="329" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_1_1" value="SWE2-02  Register ownership, volatile access, RMW, clocks and reset semantics are defined." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="918" y="378" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_1_2" value="SWE2-03  Concurrency, ISR synchronization, scheduling and reentrancy are addressed." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="918" y="427" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_1_3" value="SWE2-04  Safety mechanisms, degraded states and architecture dependencies are defined." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="918" y="476" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_1_4" value="SWE2-05  Memory/time budgets are allocated and justified across components." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="918" y="525" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_1_5" value="SWE2-06  Architecture decisions and bidirectional SWE.1 trace are consistent." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="918" y="574" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_footer_1" value="Every failed required check → finding ID → owner → fix → re-inspection" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#b83d52;fontSize=14;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="921" y="626" width="754" height="24" as="geometry"/></mxCell><mxCell id="c_bg_2" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d3ddeb;fontColor=#172842;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1742" y="240" width="806" height="419" as="geometry"/></mxCell><mxCell id="c_hd_2" value="SWE.3  ·  DETAILED DESIGN &amp; C/H" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#193253;strokeColor=#193253;fontColor=#ffffff;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1758" y="256" width="774" height="55" as="geometry"/></mxCell><mxCell id="c_2_0" value="SWE3-01  Detailed design and unit-level APIs/interfaces match the software architecture." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1762" y="329" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_2_1" value="SWE3-02  C code handles register access, volatile, bounds, initialization and RMW safely." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1762" y="378" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_2_2" value="SWE3-03  ISR/concurrency, interrupts, timing and error propagation are bounded." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1762" y="427" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_2_3" value="SWE3-04  MISRA C coverage/deviations and static-analysis findings are recorded." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1762" y="476" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_2_4" value="SWE3-05  No heap where prohibited; stack/Flash/RAM impacts are measured or budgeted." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1762" y="525" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_2_5" value="SWE3-06  Units and source match design, with change/trace provenance." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1762" y="574" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_footer_2" value="Every failed required check → finding ID → owner → fix → re-inspection" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#b83d52;fontSize=14;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1765" y="626" width="754" height="24" as="geometry"/></mxCell><mxCell id="c_bg_3" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d3ddeb;fontColor=#172842;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="54" y="701" width="806" height="419" as="geometry"/></mxCell><mxCell id="c_hd_3" value="SWE.4  ·  UNIT VERIFICATION" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#193253;strokeColor=#193253;fontColor=#ffffff;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="70" y="717" width="774" height="55" as="geometry"/></mxCell><mxCell id="c_3_0" value="SWE4-01  Verification measures, environment, entry/exit criteria and regression are defined." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="74" y="790" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_3_1" value="SWE4-02  All units have appropriate positive, negative, boundary and error tests." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="74" y="839" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_3_2" value="SWE4-03  Mock register semantics and hardware side effects are assessed for fidelity." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="74" y="888" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_3_3" value="SWE4-04  Static-analysis and coding-rule gaps receive review or deviations." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="74" y="937" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_3_4" value="SWE4-05  Coverage goals and structural coverage reports are linked to actual results." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="74" y="986" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_3_5" value="SWE4-06  Unit/design/test/result traceability, reproducible logs and findings exist." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="74" y="1035" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_footer_3" value="Every failed required check → finding ID → owner → fix → re-inspection" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#b83d52;fontSize=14;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="77" y="1087" width="754" height="24" as="geometry"/></mxCell><mxCell id="c_bg_4" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d3ddeb;fontColor=#172842;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="898" y="701" width="806" height="419" as="geometry"/></mxCell><mxCell id="c_hd_4" value="SWE.5  ·  COMPONENT &amp; INTEGRATION" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#193253;strokeColor=#193253;fontColor=#ffffff;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="914" y="717" width="774" height="55" as="geometry"/></mxCell><mxCell id="c_4_0" value="SWE5-01  Component behavior and software integration verification are both planned." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingT