xCell><mxCell id="c_4_5" value="SWE5-06  Simulation vs target evidence limitations are explicit and unresolved defects tracked." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="918" y="1035" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_footer_4" value="Every failed required check → finding ID → owner → fix → re-inspection" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#b83d52;fontSize=14;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="921" y="1087" width="754" height="24" as="geometry"/></mxCell><mxCell id="c_bg_5" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d3ddeb;fontColor=#172842;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1742" y="701" width="806" height="419" as="geometry"/></mxCell><mxCell id="c_hd_5" value="SWE.6  ·  SOFTWARE VERIFICATION" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#193253;strokeColor=#193253;fontColor=#ffffff;fontSize=20;fontFamily=Arial;align=center;verticalAlign=middle;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1758" y="717" width="774" height="55" as="geometry"/></mxCell><mxCell id="c_5_0" value="SWE6-01  Integrated software is verified against approved SWE.1 requirements." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFam