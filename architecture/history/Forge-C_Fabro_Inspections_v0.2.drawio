Top=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1762" y="986" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_5_5" value="SWE6-06  Final verification summary states unverified hardware/ASIL gaps accurately." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8faff;strokeColor=none;fontColor=#172842;fontSize=15;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1762" y="1035" width="768" height="45" as="geometry"/></mxCell><mxCell id="c_footer_5" value="Every failed required check → finding ID → owner → fix → re-inspection" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#b83d52;fontSize=14;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=1;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="1765" y="1087" width="754" height="24" as="geometry"/></mxCell><mxCell id="p6_foot" value="See companion YAML files for stable IDs, required/optional flags, evidence rules and severity defaults. These are project checklists, not proprietary MISRA rule reproductions." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#546781;fontSize=17;fontFamily=Arial;align=left;verticalAlign=middle;strokeWidth=0;fontStyle=0;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;shadow=0;glass=0;" vertex="1" parent="1"><mxGeometry x="55" y="1253" width="2460" height="48" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
