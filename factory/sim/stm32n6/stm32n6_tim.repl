// Forge-C minimal STM32N6 (Cortex-M55) platform for TIM driver target tests. NOT a full SoC model:
// CPU + NVIC + AXISRAM (code/data/mailbox) + a behavioural TIM2 counter model (tim_model.py) at RM0486 base 0x50000000 (secure, p.181).
cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m55"
    nvic: nvic

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    -> cpu@0

axisram: Memory.MappedMemory @ sysbus 0x34000000
    size: 0x200000

tim: Python.PythonPeripheral @ sysbus 0x50000000
    size: 0x400
    initable: true
    filename: "TIM_MODEL_PATH"
