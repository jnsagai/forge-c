// Forge-C minimal STM32N6 (Cortex-M55) platform for GPIO driver target tests. NOT a full SoC model:
// CPU + NVIC + AXISRAM (code/data/mailbox) + a behavioural GPIOA port model (gpio_model.py) at RM0486 base 0x56020000 (secure, p.176).
cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m55"
    nvic: nvic

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    -> cpu@0

axisram: Memory.MappedMemory @ sysbus 0x34000000
    size: 0x200000

gpio: Python.PythonPeripheral @ sysbus 0x56020000
    size: 0x400
    initable: true
    filename: "GPIO_MODEL_PATH"
