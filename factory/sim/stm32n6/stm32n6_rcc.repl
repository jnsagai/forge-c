// Forge-C minimal STM32N6 (Cortex-M55) platform for RCC driver target tests. NOT a full SoC model:
// CPU + NVIC + AXISRAM (code/data/mailbox) + a behavioural RCC model (rcc_model.py) at RM0486 base 0x56028000.
cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m55"
    nvic: nvic

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    -> cpu@0

axisram: Memory.MappedMemory @ sysbus 0x34000000
    size: 0x200000

// RCC window: RM0486 memory map 0x56028000-0x56029FFF (8 KB)
rcc: Python.PythonPeripheral @ sysbus 0x56028000
    size: 0x2000
    initable: true
    filename: "RCC_MODEL_PATH"
