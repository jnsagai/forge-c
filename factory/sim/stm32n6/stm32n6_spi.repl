// Forge-C minimal STM32N6 (Cortex-M55) platform for SPI driver target tests. NOT a full SoC model:
// CPU + NVIC + AXISRAM (code/data/mailbox) + a behavioural SPI1 loopback model (spi_model.py) at RM0486 base 0x52003000 (secure, p.180).
cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m55"
    nvic: nvic

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    -> cpu@0

axisram: Memory.MappedMemory @ sysbus 0x34000000
    size: 0x200000

spi: Python.PythonPeripheral @ sysbus 0x52003000
    size: 0x400
    initable: true
    filename: "SPI_MODEL_PATH"
