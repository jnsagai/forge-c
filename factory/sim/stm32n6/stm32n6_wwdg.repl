// Forge-C minimal STM32N6 (Cortex-M55) platform for WWDG driver target tests. NOT a full SoC model:
// CPU + NVIC + AXISRAM (code/data/mailbox) + a behavioural WWDG model (wwdg_model.py) at RM0486 base 0x50002C00 (secure, p.181).
cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m55"
    nvic: nvic

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    -> cpu@0

axisram: Memory.MappedMemory @ sysbus 0x34000000
    size: 0x200000

wwdg: Python.PythonPeripheral @ sysbus 0x50002C00
    size: 0x400
    initable: true
    filename: "WWDG_MODEL_PATH"
