{
  "schema": "forge-c/release-package-policy/0.3",
  "baseline": "Automotive SPICE PAM 4.0, tailored Forge-C SWE.1-SWE.6",
  "safety_target": "ISO 26262-6:2018 ASIL B evidence candidate",
  "require_no_open_findings": true,
  "require_completed_run": true,
  "required_sections": [
    "configuration",
    "inspection/SWE.1",
    "inspection/SWE.2",
    "inspection/SWE.3",
    "inspection/SWE.4",
    "inspection/SWE.5",
    "inspection/SWE.6",
    "safety",
    "software/build",
    "software/include",
    "software/src",
    "support/SUP.1",
    "support/SUP.10",
    "support/SUP.8",
    "support/SUP.9",
    "traceability",
    "verification/coverage",
    "verification/footprint",
    "verification/integration",
    "verification/software",
    "verification/static",
    "verification/target",
    "verification/unit",
    "workproducts/SWE.1",
    "workproducts/SWE.2",
    "workproducts/SWE.3",
    "workproducts/SWE.4",
    "workproducts/SWE.5",
    "workproducts/SWE.6"
  ],
  "required_quality_checks": [
    "swe1_inspection",
    "swe2_inspection",
    "swe3_inspection",
    "swe4_inspection",
    "swe5_inspection",
    "swe6_inspection",
    "misra_coverage_assessed",
    "static_analysis",
    "unit_verification",
    "integration_verification",
    "software_verification",
    "traceability",
    "resource_budgets",
    "target_verification",
    "safety_gaps_declared"
  ],
  "quality_report": "quality/final-gates.json",
  "required_files": [
    "configuration/target_baseline.json",
    "configuration/toolchain_versions.json",
    "workproducts/SWE.1/software_requirements.md",
    "workproducts/SWE.2/software_architecture.md",
    "workproducts/SWE.3/detailed_design.md",
    "workproducts/SWE.4/unit_verification_report.md",
    "workproducts/SWE.5/integration_verification_report.md",
    "workproducts/SWE.6/software_verification_report.md",
    "support/SUP.1/quality_assurance_status.md",
    "support/SUP.8/configuration_status.md",
    "support/SUP.9/problem_resolution_status.md",
    "support/SUP.10/change_request_status.md",
    "safety/software_safety_requirements.md",
    "safety/software_safety_analysis.md",
    "safety/tool_assurance_assessment.md",
    "safety/known_limitations.md",
    "traceability/requirements_to_tests.csv",
    "verification/static/analysis_summary.json",
    "verification/unit/unit_verification_summary.json",
    "verification/integration/integration_verification_summary.json",
    "verification/software/software_verification_summary.json",
    "verification/coverage/coverage_summary.json",
    "verification/footprint/memory_stack_summary.json",
    "verification/target/target_verification_summary.json",
    "inspection/SWE.1/inspection_record.json",
    "inspection/SWE.2/inspection_record.json",
    "inspection/SWE.3/inspection_record.json",
    "inspection/SWE.4/inspection_record.json",
    "inspection/SWE.5/inspection_record.json",
    "inspection/SWE.6/inspection_record.json"
  ],
  "required_patterns": [
    "software/src/*.c",
    "software/include/*.h",
    "software/build/*.elf",
    "software/build/*.map"
  ]
}
