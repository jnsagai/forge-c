, "output_bytes_retained": 1613, "tool_call_id": "call_36ho9iop", "tool_name": "use_skill"}}, "seq": 12, "session_id": "ses_118ab385-e56b-435f-8ea1-a0cb273c26f3", "stage": "probe", "stream_id": "ses_118ab385-e56b-435f-8ea1-a0cb273c26f3", "timestamp": "2026-10-14T21:01:15.954Z", "tool_call_id": "call_36ho9iop", "visit": 1}, "run_id": "01M4Y3G729G75FJC15RT4K585C", "seq": 33, "session_id": "ses_118ab385-e56b-435f-8ea1-a0cb273c26f3", "stage_id": "probe@1", "tool_call_id": "call_36ho9iop", "ts": "2026-10-14T21:01:15.956918612Z"}
