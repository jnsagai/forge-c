---
import replay from "../../public/media/recorded-run.json";
const phases = [
  "Requirements",
  "Architecture",
  "Implementation",
  "Unit verification",
  "Integration",
  "Qualification",
];
const source =
  "https://github.com/jnsagai/forge-c/blob/main/evidence/v0.4/runs/RC1/WO-0009B-STM32N6-IWDG-HAL-rc4/";
const base = import.meta.env.BASE_URL;
---

<section
  class="replay-section"
  id="workflow-demo"
  aria-labelledby="replay-heading"
>
  <div class="wrap">
    <div class="section-heading">
      <div>
        <span class="eyebrow">WATCH THE FACTORY / RECORDED EVIDENCE</span><h2
          id="replay-heading"
        >
          Follow a real run.<br />Including the rework.
        </h2>
      </div><p>
        The IWDG HAL rc4 run, 21 October 2026. Replay its recorded gates in 45
        seconds, from rejected requirements to a sealed review package. This is
        a visualization of the log, not a live run or screen recording.
      </p>
    </div>
    <div
      class="replay-frame"
      data-replay
      data-events={JSON.stringify(replay.events)}
    >
      <div class="replay-top mono">
        <span>FORGE-C / IWDG HAL rc4</span><span>RECORDED · 21 OCT 2026</span>
      </div>
      <div class="replay-body">
        <div class="replay-intro">
          <span class="mono small-label">WORK ORDER 0009B / STM32N6</span
          ><strong>From findings to evidence.</strong><p
            data-replay-time
            class="mono"
          >
            08:17:48 UTC
          </p>
        </div>
        <div class="replay-stations">
          {
            phases.map((name, index) => (
              <div
                class:list={["replay-station", { active: index === 0 }]}
                data-replay-phase={`SWE.${index + 1}`}
              >
                <>
                  <span class="mono">SWE.{index + 1}</span>
                  <strong>{name}</strong>
                  <small data-phase-status>
                    {index === 0 ? "REJECTED" : "WAITING"}
                  </small>
                </>
              </div>
            ))
          }
        </div>
        <div class="replay-event">
          <div>
            <span class="mono" data-replay-step>SWE.1 / AUTHOR</span><span
              class="replay-badge"
              data-replay-outcome>REJECTED</span>
          </div><p data-replay-detail>{replay.events[0].detail}</p>
        </div>
        <div class="replay-footer mono">
          <span data-replay-progress>EVENT 01 / 18</span><span
            data-replay-package>FINAL PACKAGE / PENDING</span>
        </div>
      </div>
      <div class="replay-controls">
        <button
          type="button"
          class="button primary"
          data-replay-play
          aria-label="Play recorded workflow replay"
          >Play replay <span aria-hidden="true">▶</span></button
        ><button type="button" class="replay-step-button" data-replay-next
          >Next event →</button
        ><label class="replay-slider"
          ><span class="sr-only">Recorded workflow event</span><input
            type="range"
            min="0"
            max={replay.events.length - 1}
            value="0"
            step="1"
            aria-label="Recorded workflow event"
            data-replay-seek
          /></label
        ><span class="mono" data-replay-counter>1 / 18</span>
      </div>
    </div>
    <div class="replay-source">
      <p>
        Time compressed · 17 gate events + package finalization · 2 rework
        decisions · 0 gaps in the final configured package.
      </p><a class="text-link" href={source + "gate-log.jsonl"}
        >Inspect the source log ↗</a>
    </div>
    <details class="replay-video">
      <summary
        >Watch the video version <span class="mono"
          >45 SEC / CAPTIONED / NO AUDIO</span
        ></summary
      ><video
        controls
        playsinline
        preload="none"
        poster={`${base}media/workflow-replay-poster.png`}
        aria-label="Recorded IWDG HAL workflow event visualization, 45 seconds"
        ><source
          src={`${base}media/workflow-replay.mp4`}
          type="video/mp4"
        /><track
          kind="captions"
          src={`${base}media/workflow-replay.vtt`}
          srclang="en"
          label="English event descriptions"
          default
        /><p>
          <a href={`${base}media/workflow-replay.mp4`}
            >Download the workflow video</a
          >.
        </p></video
      ><p>
        The same recorded-event visualization as above. Rendered from the gate
        log; not footage of a live runtime.
      </p>
    </details>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>("[data-replay]").forEach((root) => {
    type Event = {
      phase: string;
      step: string;
      outcome: string;
      timestamp: string;
      detail: string;
    };
    const events: Event[] = JSON.parse(root.dataset.events!);
    const play = root.querySelector<HTMLButtonElement>("[data-replay-play]")!;
    const slider = root.querySelector<HTMLInputElement>("[data-replay-seek]")!;
    let current = 0;
    let timer: ReturnType<typeof setInterval> | undefined;
    function render(index: number) {
      current = Math.max(0, Math.min(events.length - 1, index));
      const event = events[current];
      root.querySelector("[data-replay-time]")!.textContent =
        event.timestamp.slice(11, 19) + " UTC";
      root.querySelector("[data-replay-step]")!.textContent =
        `${event.phase} / ${event.step.toUpperCase()}`;
      root.querySelector("[data-replay-outcome]")!.textContent = event.outcome;
      root.querySelector("[data-replay-detail]")!.textContent = event.detail;
      root.querySelector("[data-replay-progress]")!.textContent =
        `EVENT ${String(current + 1).padStart(2, "0")} / ${events.length}`;
      root.querySelector("[data-replay-counter]")!.textContent =
        `${current + 1} / ${events.length}`;
      root.querySelector("[data-replay-package]")!.textContent =
        event.phase === "PACKAGE"
          ? "PACKAGE / SEALED · 0 GAPS"
          : "FINAL PACKAGE / PENDING";
      root
        .querySelector("[data-replay-outcome]")!
        .classList.toggle(
          "pass",
          event.outcome === "PASS" || event.phase === "PACKAGE",
        );
      root
        .querySelectorAll<HTMLElement>("[data-replay-phase]")
        .forEach((station) => {
          const phase = station.dataset.replayPhase!;
          const seen = events
            .slice(0, current + 1)
            .filter((item) => item.phase === phase);
          const passed = seen.some(
            (item) => item.step === "inspect" && item.outcome === "PASS",
          );
          station.classList.toggle("active", phase === event.phase);
          station.classList.toggle("passed", passed);
          station.querySelector("[data-phase-status]")!.textContent = passed
            ? "GATE PASS"
            : seen.at(-1)?.outcome || "WAITING";
        });
      slider.value = String(current);
      slider.setAttribute(
        "aria-valuetext",
        `${current + 1} of ${events.length}: ${event.phase} ${event.step}, ${event.outcome}`,
      );
    }
    function pause() {
      if (timer) clearInterval(timer);
      timer = undefined;
      root.classList.remove("playing");
      play.innerHTML = 'Play replay <span aria-hidden="true">▶</span>';
      play.setAttribute("aria-label", "Play recorded workflow replay");
    }
    play.addEventListener("click", () => {
      if (timer) {
        pause();
        return;
      }
      if (current === events.length - 1) render(0);
      play.innerHTML = 'Pause replay <span aria-hidden="true">Ⅱ</span>';
      play.setAttribute("aria-label", "Pause recorded workflow replay");
      root.classList.add("playing");
      timer = setInterval(() => {
        if (current < events.length - 1) render(current + 1);
        else pause();
      }, 2500);
    });
    slider.addEventListener("input", () => {
      pause();
      render(Number(slider.value));
    });
    root.querySelector("[data-replay-next]")!.addEventListener("click", () => {
      pause();
      render((current + 1) % events.length);
    });
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) pause();
    });
    // Deterministic capture hook used only by the optional local video-render helper.
    root.addEventListener("forge-replay-seek", ((
      event: CustomEvent<number>,
    ) => {
      pause();
      render(event.detail);
    }) as EventListener);
    render(0);
  });
</script>
<style>
  .replay-section {
    padding-block: 80px;
    border-bottom: 1px solid #30373d;
    background: #191e22;
  }
  .replay-frame {
    border: 1px solid #4b4f4d;
    border-radius: 8px;
    background: #11171b;
    overflow: hidden;
  }
  .replay-top {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    padding: 17px 24px;
    border-bottom: 1px solid #30373d;
    font-size: 10px;
    color: #b8c4ca;
    letter-spacing: 0.06em;
  }
  .replay-top > span:last-child {
    color: #f4a66b;
  }
  .replay-body {
    padding: 28px;
  }
  .replay-intro {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .replay-intro > strong {
    font-size: 28px;
    font-weight: 550;
    letter-spacing: -0.03em;
  }
  .replay-intro > p {
    font-size: 11px;
    color: #b3bdc4;
    margin: 0 0 24px;
  }
  .replay-stations {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 10px;
    position: relative;
  }
  .replay-station {
    border: 1px solid #3b454b;
    border-radius: 5px;
    padding: 18px 12px;
    background: #1a2228;
    position: relative;
    transition:
      border-color 0.2s,
      background 0.2s;
  }
  .replay-station:not(:last-child)::after {
    content: "→";
    position: absolute;
    right: -12px;
    top: 40%;
    color: #77848d;
    z-index: 1;
  }
  .replay-station > span {
    font-size: 10px;
    color: #9dabb6;
  }
  .replay-station > strong {
    display: block;
    font-size: 12px;
    font-weight: 550;
    margin: 18px 0;
    min-height: 30px;
  }
  .replay-station > small {
    font:
      9px Consolas,
      monospace;
    color: #aeb9bf;
  }
  .replay-station.active {
    border-color: #e3a273;
    background: #3b2c22;
  }
  .replay-station.active > span,
  .replay-station.active > small {
    color: #f4b88a;
  }
  .replay-station.passed {
    border-color: #547566;
  }
  .replay-station.passed > small {
    color: #a8d6ba;
  }
  .replay-event {
    margin-top: 24px;
    padding: 20px;
    border: 1px solid #3b454c;
    background: #192127;
    border-radius: 5px;
    min-height: 118px;
  }
  .replay-event > div {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    font-size: 11px;
  }
  .replay-badge {
    font:
      10px Consolas,
      monospace;
    color: #ffd0a4;
  }
  .replay-badge.pass {
    color: #a8d6ba;
  }
  .replay-event > p {
    font-size: 13px;
    color: #c4cdd3;
    margin: 14px 0 0;
    line-height: 1.7;
    max-width: 900px;
  }
  .replay-footer {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    color: #a6b3bc;
    font-size: 9px;
    margin-top: 22px;
    letter-spacing: 0.04em;
  }
  .replay-controls {
    display: flex;
    align-items: center;
    gap: 22px;
    padding: 18px 28px;
    border-top: 1px solid #30373d;
    background: #1c2429;
  }
  .replay-controls .button {
    font-size: 11px;
    padding: 11px 14px;
    min-width: 140px;
    justify-content: space-between;
    border: 0;
  }
  .replay-step-button {
    color: #d5dcdf;
    background: none;
    border: 0;
    font-size: 11px;
    white-space: nowrap;
  }
  .replay-slider {
    flex: 1;
    min-width: 60px;
  }
  .replay-slider > input {
    width: 100%;
    accent-color: #f4a66b;
    cursor: pointer;
  }
  .replay-controls > [data-replay-counter] {
    font-size: 10px;
    white-space: nowrap;
    color: #bac7cf;
  }
  .replay-source {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: start;
    margin-top: 14px;
  }
  .replay-source > p {
    font-size: 11px;
    color: #a7b3bb;
    margin: 0;
  }
  .replay-source > .text-link {
    white-space: nowrap;
    font-size: 11px;
  }
  .replay-video {
    border: 1px solid #3b464d;
    border-radius: 5px;
    margin-top: 26px;
    padding: 18px 22px;
  }
  .replay-video > summary {
    font-size: 13px;
    cursor: pointer;
    color: #f4b88a;
  }
  .replay-video > summary > span {
    font-size: 9px;
    color: #b6c1c9;
    margin-left: 24px;
  }
  .replay-video video {
    display: block;
    width: 100%;
    margin-top: 20px;
    border-radius: 4px;
    background: #11171b;
    aspect-ratio: 16/9;
  }
  .replay-video > p {
    font-size: 11px;
    color: #afbdc6;
    margin-bottom: 0;
  }
  .sr-only {
    position: absolute;
    clip: rect(0, 0, 0, 0);
    width: 1px;
    height: 1px;
    overflow: hidden;
    white-space: nowrap;
  }
  @media (max-width: 900px) {
    .replay-stations {
      grid-template-columns: repeat(3, 1fr);
    }
    .replay-station:nth-child(3)::after {
      display: none;
    }
    .replay-station > strong {
      min-height: 0;
      margin: 12px 0;
    }
    .replay-source {
      flex-direction: column;
      gap: 10px;
    }
    .replay-controls {
      gap: 14px;
    }
    .replay-controls .button {
      min-width: 125px;
    }
    .replay-video > summary > span {
      display: block;
      margin: 10px 0 0;
    }
  }
  @media (max-width: 500px) {
    .replay-section {
      padding-block: 55px;
    }
    .replay-top {
      padding: 14px;
      font-size: 7px;
    }
    .replay-body {
      padding: 18px 14px;
    }
    .replay-intro > strong {
      font-size: 23px;
    }
    .replay-stations {
      gap: 8px;
    }
    .replay-station {
      padding: 12px 7px;
    }
    .replay-station > strong {
      font-size: 10px;
      min-height: 25px;
    }
    .replay-station > small {
      font-size: 8px;
    }
    .replay-event {
      padding: 15px;
      min-height: 160px;
    }
    .replay-event > div {
      flex-direction: column;
      align-items: flex-start;
    }
    .replay-event > p {
      font-size: 12px;
    }
    .replay-footer {
      font-size: 7px;
      gap: 8px;
    }
    .replay-controls {
      padding: 14px;
      gap: 12px;
      flex-wrap: wrap;
    }
    .replay-controls .button {
      min-width: 130px;
    }
    .replay-step-button {
      margin-left: auto;
    }
    .replay-slider {
      flex-basis: 70%;
    }
    .replay-video {
      padding: 15px;
    }
    .replay-source > p {
      line-height: 1.8;
    }
  }
  .playing .replay-station.active::before {
    content: "";
    position: absolute;
    top: 10px;
    right: 10px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #f4b88a;
    animation: station-pulse 1.2s ease-in-out infinite;
  }
  @keyframes station-pulse {
    50% {
      opacity: 0.3;
      box-shadow: 0 0 0 5px #f4b88a22;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .replay-station {
      transition: none;
    }
    .playing .replay-station.active::before {
      animation: none;
    }
  }
</style>
