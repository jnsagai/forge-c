{
  "name": "forge-c-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "generate": "python3 scripts/generate.py",
    "dev": "npm run generate && astro dev --host 127.0.0.1",
    "build": "npm run generate && astro build && pagefind --site dist && python3 scripts/check_site.py",
    "preview": "astro preview --host 127.0.0.1",
    "test": "python3 -m unittest discover -s tests -v"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.0",
    "@astrojs/starlight": "0.42.7",
    "astro": "7.4.2",
    "pagefind": "1.4.0"
  }
}
