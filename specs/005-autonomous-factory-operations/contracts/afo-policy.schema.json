{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AFO Control Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "feature_id",
    "mode",
    "integration",
    "host",
    "queue",
    "budgets",
    "engineering",
    "maintenance",
    "security",
    "slo",
    "notifications"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "feature_id": {
      "const": "005-autonomous-factory-operations"
    },
    "mode": {
      "enum": [
        "DISABLED",
        "OBSERVE_ONLY",
        "PILOT",
        "ACTIVE"
      ]
    },
    "integration": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Integration",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reuse_002_supervisor",
        "reuse_004_cre",
        "reuse_003_kpi",
        "use_existing_fabro",
        "no_auto_source_deploy"
      ],
      "properties": {
        "reuse_002_supervisor": {
          "const": true
        },
        "reuse_004_cre": {
          "const": true
        },
        "reuse_003_kpi": {
          "const": true
        },
        "use_existing_fabro": {
          "const": true
        },
        "no_auto_source_deploy": {
          "const": true
        }
      }
    },
    "host": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Host Policy",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_dir_env",
        "data_root_env",
        "require_stable_mount",
        "mount_marker",
        "require_write_probe",
        "linger_operator_managed"
      ],
      "properties": {
        "state_dir_env": {
          "type": "string"
        },
        "data_root_env": {
          "type": "string"
        },
        "require_stable_mount": {
          "const": true
        },
        "mount_marker": {
          "type": "string"
        },
        "require_write_probe": {
          "const": true
        },
        "linger_operator_managed": {
          "const": true
        }
      }
    },
    "queue": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Queue Limits",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_concurrent_workorders",
        "max_queued_orders",
        "priority_aging_seconds",
        "lease_seconds",
        "control_poll_seconds",
        "submission_requires_approval",
        "allow_autogenerated_work_orders"
      ],
      "properties": {
        "max_concurrent_workorders": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "max_queued_orders": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "priority_aging_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "lease_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "control_poll_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "submission_requires_approval": {
          "const": true
        },
        "allow_autogenerated_work_orders": {
          "const": false
        }
      }
    },
    "budgets": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Budget Limits",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_order_attempts",
        "max_strategy_variants_per_phase",
        "max_recovery_model_calls_per_order",
        "max_model_tokens_per_order",
        "max_gpu_seconds_per_order",
        "max_recovery_wall_seconds",
        "max_order_wall_seconds",
        "max_retries_per_transient_operation"
      ],
      "properties": {
        "max_order_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "max_strategy_variants_per_phase": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "max_recovery_model_calls_per_order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "max_model_tokens_per_order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "max_gpu_seconds_per_order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "max_recovery_wall_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "max_order_wall_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "max_retries_per_transient_operation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        }
      }
    },
    "engineering": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Engineering Controls",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_scoped_product_draft_rework",
        "enable_recovery_planner",
        "allowed_model_profiles",
        "preserve_independent_inspector",
        "require_material_difference",
        "require_frozen_upstream_revalidation"
      ],
      "properties": {
        "allow_scoped_product_draft_rework": {
          "type": "boolean"
        },
        "enable_recovery_planner": {
          "type": "boolean"
        },
        "allowed_model_profiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "preserve_independent_inspector": {
          "type": "boolean"
        },
        "require_material_difference": {
          "type": "boolean"
        },
        "require_frozen_upstream_revalidation": {
          "type": "boolean"
        }
      }
    },
    "maintenance": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Maintenance Controls",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enable_factory_maintainer",
        "auto_merge_source",
        "auto_promote_factory_code",
        "auto_mutate_safety_policy",
        "allow_proposal_pr",
        "protect_holdouts"
      ],
      "properties": {
        "enable_factory_maintainer": {
          "type": "boolean"
        },
        "auto_merge_source": {
          "const": false
        },
        "auto_promote_factory_code": {
          "const": false
        },
        "auto_mutate_safety_policy": {
          "const": false
        },
        "allow_proposal_pr": {
          "type": "boolean"
        },
        "protect_holdouts": {
          "const": true
        }
      }
    },
    "security": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Security Controls",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_new_agent_calls_mcp_only",
        "deny_agent_direct_shell",
        "redact_secrets",
        "audit_min_level",
        "unknown_side_effect_fail_closed"
      ],
      "properties": {
        "all_new_agent_calls_mcp_only": {
          "const": true
        },
        "deny_agent_direct_shell": {
          "const": true
        },
        "redact_secrets": {
          "const": true
        },
        "audit_min_level": {
          "const": "INFO"
        },
        "unknown_side_effect_fail_closed": {
          "const": true
        }
      }
    },
    "slo": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "SLO Targets",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability_target",
        "rolling_days",
        "transient_restore_p95_seconds",
        "smoke_hours",
        "pilot_hours",
        "soak_hours",
        "measurement_only_until_calibrated"
      ],
      "properties": {
        "availability_target": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rolling_days": {
          "type": "integer",
          "minimum": 1
        },
        "transient_restore_p95_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "smoke_hours": {
          "type": "integer",
          "minimum": 1
        },
        "pilot_hours": {
          "type": "integer",
          "minimum": 1
        },
        "soak_hours": {
          "type": "integer",
          "minimum": 1
        },
        "measurement_only_until_calibrated": {
          "const": true
        }
      }
    },
    "notifications": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Alert Settings",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dedupe_window_seconds",
        "minimum_local_audit"
      ],
      "properties": {
        "dedupe_window_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "minimum_local_audit": {
          "const": true
        }
      }
    },
    "authorization_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "enum": [
              "PILOT",
              "ACTIVE"
            ]
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "required": [
          "authorization_ref"
        ]
      }
    }
  ]
}
