{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AFO Dead Letter Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "order_id",
    "reason_code",
    "required_action",
    "incident_ref",
    "artifact_refs",
    "created_utc",
    "notification_dedupe_key"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{1,127}$"
    },
    "order_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{1,127}$"
    },
    "attempt_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "required_action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "incident_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2
      },
      "uniqueItems": true
    },
    "created_utc": {
      "type": "string",
      "format": "date-time"
    },
    "notification_dedupe_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "state": {
      "type": "string",
      "enum": [
        "OPEN",
        "ACKNOWLEDGED",
        "CLOSED"
      ]
    },
    "package_status": {
      "const": "BLOCKED"
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_notification_utc": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
