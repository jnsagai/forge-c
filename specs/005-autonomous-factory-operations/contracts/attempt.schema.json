{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AFO Work Attempt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "order_id",
    "attempt_id",
    "attempt_seq",
    "state",
    "workspace_ref",
    "factory_revision",
    "created_utc"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "order_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{1,127}$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{1,127}$"
    },
    "attempt_seq": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "PREPARED",
        "DISPATCH_PENDING",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED",
        "UNKNOWN"
      ]
    },
    "workspace_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "factory_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "created_utc": {
      "type": "string",
      "format": "date-time"
    },
    "fabro_run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "fabro_server": {
      "type": [
        "string",
        "null"
      ]
    },
    "recovery_plan_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "exit_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "terminal_package_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "READY_FOR_OFFLINE_REVIEW",
        "BLOCKED",
        null
      ]
    },
    "checkpoint_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2
      },
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2
      },
      "uniqueItems": true
    },
    "receipt_sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "finished_utc": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
