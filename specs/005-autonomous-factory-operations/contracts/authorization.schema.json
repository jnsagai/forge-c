{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AFO Operator Authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authorization_id",
    "approver",
    "approval_evidence_ref",
    "issued_utc",
    "expires_utc",
    "policy_sha256",
    "mode",
    "allowed_actions",
    "scope",
    "signature_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "authorization_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{1,127}$"
    },
    "approver": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "approval_evidence_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "issued_utc": {
      "type": "string",
      "format": "date-time"
    },
    "expires_utc": {
      "type": "string",
      "format": "date-time"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "PILOT",
        "ACTIVE"
      ]
    },
    "allowed_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2
      },
      "uniqueItems": true
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "order_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          },
          "uniqueItems": true
        },
        "driver_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          },
          "uniqueItems": true
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          },
          "uniqueItems": true
        },
        "service_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          },
          "uniqueItems": true
        },
        "maintenance_window_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "signature_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "revoked_utc": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "signed_runbook_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
