{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-c.local/specs/006/contracts/coverage-evidence.schema.json",
  "title": "coverage-evidence",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "code_hash": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "STATEMENT",
        "BRANCH",
        "MCDC"
      ]
    },
    "measured": {
      "type": "boolean"
    },
    "covered": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "total": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "test_run_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "uncovered_rationale_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "tool_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "MEASURED",
        "NOT_COMPUTABLE",
        "NOT_SUPPORTED",
        "UNKNOWN"
      ]
    }
  },
  "required": [
    "code_hash",
    "kind",
    "measured",
    "covered",
    "total",
    "scope",
    "test_run_refs",
    "uncovered_rationale_refs",
    "tool_id",
    "status"
  ]
}
