{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-c.local/specs/006/contracts/safety-scope.schema.json",
  "title": "safety-scope",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "scope_id": {
      "type": "string",
      "minLength": 1
    },
    "work_order_id": {
      "type": "string",
      "minLength": 1
    },
    "target_asil": {
      "type": "string",
      "enum": [
        "QM",
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "source_requirements_hash": {
      "type": "string",
      "minLength": 1
    },
    "hsi_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "allocation_review_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "product_asil_source": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "scope_id",
    "work_order_id",
    "target_asil",
    "source_requirements_hash",
    "hsi_hash",
    "allocation_review_ref",
    "product_asil_source"
  ]
}
