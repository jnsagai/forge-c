{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Process lab work-order block (design rev 4 \u00a71)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "experiment_id",
    "driver",
    "seq",
    "role",
    "profile",
    "model_profile"
  ],
  "properties": {
    "schema": {
      "const": "forge-c/process-lab/1"
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,31}$"
    },
    "driver": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,31}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "role": {
      "enum": [
        "AUTHOR",
        "INSPECT",
        "REWORK"
      ]
    },
    "profile": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{1,127}$"
    },
    "model_profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "source_order_id": {
      "type": "string",
      "pattern": "^afo-[0-9a-f]{16}$"
    },
    "input_handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "seq": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "role": {
            "const": "AUTHOR"
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "input_handoff"
              ]
            },
            {
              "required": [
                "source_order_id"
              ]
            },
            {
              "required": [
                "findings"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "seq": {
            "minimum": 2
          }
        }
      },
      "then": {
        "required": [
          "input_handoff",
          "source_order_id"
        ],
        "properties": {
          "role": {
            "enum": [
              "INSPECT",
              "REWORK"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "REWORK"
          }
        }
      },
      "then": {
        "required": [
          "findings"
        ]
      },
      "else": {
        "not": {
          "required": [
            "findings"
          ]
        }
      }
    }
  ]
}
