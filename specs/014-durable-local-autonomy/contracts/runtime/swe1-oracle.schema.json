{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SWE.1 frozen oracle (design rev 4 \u00a79)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "driver",
    "source_hashes",
    "reviewer",
    "review_utc",
    "obligations"
  ],
  "properties": {
    "schema": {
      "const": "forge-c/swe1-oracle/1"
    },
    "driver": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,31}$"
    },
    "source_hashes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "review_utc": {
      "type": "string",
      "format": "date-time"
    },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "critical",
          "kind",
          "accepted_source_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^OBL-[A-Za-z0-9_.-]{1,60}$"
          },
          "critical": {
            "type": "boolean"
          },
          "kind": {
            "enum": [
              "behaviour",
              "caller_contract",
              "interface",
              "state",
              "error"
            ]
          },
          "accepted_source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 200
            }
          },
          "predicate": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "register",
                "field",
                "op"
              ],
              "properties": {
                "register": {
                  "type": "string",
                  "maxLength": 80
                },
                "field": {
                  "type": "string",
                  "maxLength": 80
                },
                "op": {
                  "type": "string",
                  "maxLength": 40
                },
                "value": {}
              }
            }
          },
          "note": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    }
  }
}
