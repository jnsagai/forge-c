{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forge-c:014:completion-receipt:1.0",
  "title": "Controller-authored immutable receipt revision; NOT IMPLEMENTED",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "revision",
    "previous_receipt_sha256",
    "created_at",
    "mission_id",
    "order_id",
    "attempt_id",
    "job_id",
    "case_sha256",
    "launch_nonce",
    "proposal_sha256",
    "proposal_hash_basis",
    "proposal_ref",
    "decision",
    "submission_state",
    "admissibility_state",
    "admissibility_receipt_ref",
    "bound_plan",
    "execution_state",
    "execution_id",
    "verification_receipt_ref",
    "reason_codes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{1,127}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "previous_receipt_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "mission_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{1,127}$"
    },
    "order_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{1,127}$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{1,127}$"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{1,127}$"
    },
    "case_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "launch_nonce": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "proposal_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "proposal_hash_basis": {
      "enum": [
        "CANONICAL_JSON",
        "RAW_BYTES"
      ]
    },
    "proposal_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 2,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "decision": {
      "enum": [
        "PROPOSE_REPAIR",
        "NEEDS_EVIDENCE",
        "CLOSE_BLOCKED",
        null
      ]
    },
    "submission_state": {
      "enum": [
        "STORED",
        "REJECTED"
      ]
    },
    "admissibility_state": {
      "enum": [
        "NOT_EVALUATED",
        "PENDING",
        "ACCEPTED",
        "REJECTED"
      ]
    },
    "admissibility_receipt_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 2,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "bound_plan": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "plan_id",
            "artifact_ref",
            "sha256"
          ],
          "properties": {
            "plan_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{1,127}$"
            },
            "artifact_ref": {
              "type": "string",
              "minLength": 2,
              "maxLength": 256
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "execution_state": {
      "enum": [
        "NOT_REQUESTED",
        "NOT_APPLICABLE",
        "DISPATCH_PENDING",
        "APPLYING",
        "VERIFYING",
        "VERIFIED",
        "FAILED",
        "CANCELLED",
        "UNKNOWN"
      ]
    },
    "execution_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{1,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "verification_receipt_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 2,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{1,79}$"
      },
      "minItems": 0,
      "maxItems": 16,
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "revision": {
            "const": 1
          }
        },
        "required": [
          "revision"
        ]
      },
      "then": {
        "properties": {
          "previous_receipt_sha256": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "revision": {
            "minimum": 2
          }
        },
        "required": [
          "revision"
        ]
      },
      "then": {
        "properties": {
          "previous_receipt_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "submission_state": {
            "const": "REJECTED"
          }
        },
        "required": [
          "submission_state"
        ]
      },
      "then": {
        "properties": {
          "admissibility_state": {
            "const": "NOT_EVALUATED"
          },
          "admissibility_receipt_ref": {
            "type": "null"
          },
          "execution_state": {
            "const": "NOT_REQUESTED"
          },
          "execution_id": {
            "type": "null"
          },
          "verification_receipt_ref": {
            "type": "null"
          },
          "decision": {
            "type": "null"
          },
          "proposal_ref": {
            "type": "null"
          },
          "bound_plan": {
            "type": "null"
          },
          "reason_codes": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "submission_state": {
            "const": "STORED"
          }
        },
        "required": [
          "submission_state"
        ]
      },
      "then": {
        "properties": {
          "admissibility_state": {
            "enum": [
              "PENDING",
              "ACCEPTED",
              "REJECTED"
            ]
          },
          "decision": {
            "enum": [
              "PROPOSE_REPAIR",
              "NEEDS_EVIDENCE",
              "CLOSE_BLOCKED"
            ]
          },
          "proposal_hash_basis": {
            "const": "CANONICAL_JSON"
          },
          "proposal_ref": {
            "type": "string",
            "minLength": 2,
            "maxLength": 256
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "admissibility_state": {
            "enum": [
              "NOT_EVALUATED",
              "PENDING",
              "REJECTED"
            ]
          }
        },
        "required": [
          "admissibility_state"
        ]
      },
      "then": {
        "properties": {
          "execution_state": {
            "const": "NOT_REQUESTED"
          },
          "execution_id": {
            "type": "null"
          },
          "verification_receipt_ref": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "admissibility_state": {
            "const": "PENDING"
          }
        },
        "required": [
          "admissibility_state"
        ]
      },
      "then": {
        "properties": {
          "admissibility_receipt_ref": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "admissibility_state": {
            "enum": [
              "ACCEPTED",
              "REJECTED"
            ]
          }
        },
        "required": [
          "admissibility_state"
        ]
      },
      "then": {
        "properties": {
          "admissibility_receipt_ref": {
            "type": "string",
            "minLength": 2,
            "maxLength": 256
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "admissibility_state": {
            "const": "REJECTED"
          }
        },
        "required": [
          "admissibility_state"
        ]
      },
      "then": {
        "properties": {
          "reason_codes": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "admissibility_state": {
            "const": "ACCEPTED"
          },
          "decision": {
            "enum": [
              "PROPOSE_REPAIR",
              "CLOSE_BLOCKED"
            ]
          }
        },
        "required": [
          "admissibility_state",
          "decision"
        ]
      },
      "then": {
        "properties": {
          "bound_plan": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "admissibility_state": {
            "const": "ACCEPTED"
          },
          "decision": {
            "enum": [
              "NEEDS_EVIDENCE",
              "CLOSE_BLOCKED"
            ]
          }
        },
        "required": [
          "admissibility_state",
          "decision"
        ]
      },
      "then": {
        "properties": {
          "execution_state": {
            "const": "NOT_APPLICABLE"
          },
          "execution_id": {
            "type": "null"
          },
          "verification_receipt_ref": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "NEEDS_EVIDENCE"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "bound_plan": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "admissibility_state": {
            "const": "ACCEPTED"
          },
          "decision": {
            "const": "PROPOSE_REPAIR"
          }
        },
        "required": [
          "admissibility_state",
          "decision"
        ]
      },
      "then": {
        "properties": {
          "execution_state": {
            "enum": [
              "NOT_REQUESTED",
              "DISPATCH_PENDING",
              "APPLYING",
              "VERIFYING",
              "VERIFIED",
              "FAILED",
              "CANCELLED",
              "UNKNOWN"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_state": {
            "enum": [
              "DISPATCH_PENDING",
              "APPLYING",
              "VERIFYING",
              "VERIFIED",
              "FAILED",
              "CANCELLED",
              "UNKNOWN"
            ]
          }
        },
        "required": [
          "execution_state"
        ]
      },
      "then": {
        "properties": {
          "submission_state": {
            "const": "STORED"
          },
          "admissibility_state": {
            "const": "ACCEPTED"
          },
          "decision": {
            "const": "PROPOSE_REPAIR"
          },
          "bound_plan": {
            "type": "object"
          },
          "execution_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{1,127}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_state": {
            "enum": [
              "NOT_REQUESTED",
              "NOT_APPLICABLE"
            ]
          }
        },
        "required": [
          "execution_state"
        ]
      },
      "then": {
        "properties": {
          "execution_id": {
            "type": "null"
          },
          "verification_receipt_ref": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_state": {
            "const": "VERIFIED"
          }
        },
        "required": [
          "execution_state"
        ]
      },
      "then": {
        "properties": {
          "verification_receipt_ref": {
            "type": "string",
            "minLength": 2,
            "maxLength": 256
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_state": {
            "not": {
              "const": "VERIFIED"
            }
          }
        },
        "required": [
          "execution_state"
        ]
      },
      "then": {
        "properties": {
          "verification_receipt_ref": {
            "type": "null"
          }
        }
      }
    }
  ]
}
