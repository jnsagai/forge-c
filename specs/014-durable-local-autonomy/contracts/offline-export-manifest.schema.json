{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forge-c:contract:offline-export-manifest:1",
  "title": "Offline export bundle manifest (DA-FR-056)",
  "description": "Manifest of a deterministic export of finished local runs, carried from the offline factory to development. Records are exported in full only from an allowlist; every other workspace file is listed by hash. Vendor inputs are never exported. Keys that carry prompts or reasoning are removed and counted; secrets are redacted and counted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "factory",
    "rules",
    "runs",
    "totals"
  ],
  "properties": {
    "schema": {
      "const": "forge-c/offline-export/1"
    },
    "factory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "dirty"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|UNKNOWN)$"
        },
        "dirty": {
          "type": "boolean"
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included",
        "never_content",
        "stripped_keys"
      ],
      "properties": {
        "included": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "never_content": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "stripped_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/run"
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runs",
        "files",
        "included",
        "stripped_keys",
        "redactions"
      ],
      "properties": {
        "runs": {
          "type": "integer",
          "minimum": 0
        },
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "included": {
          "type": "integer",
          "minimum": 0
        },
        "stripped_keys": {
          "type": "integer",
          "minimum": 0
        },
        "redactions": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_key",
        "workorder",
        "files"
      ],
      "properties": {
        "run_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+-[0-9a-f]{12}$"
        },
        "workorder": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          }
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes",
        "content"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "content": {
          "enum": [
            "INCLUDED",
            "HASH_ONLY",
            "NEVER_CONTENT"
          ]
        },
        "exported_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "stripped_keys": {
          "type": "integer",
          "minimum": 0
        },
        "redactions": {
          "type": "integer",
          "minimum": 0
        }
      },
      "if": {
        "properties": {
          "content": {
            "const": "INCLUDED"
          }
        }
      },
      "then": {
        "required": [
          "exported_sha256",
          "stripped_keys",
          "redactions"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "exported_sha256"
              ]
            },
            {
              "required": [
                "stripped_keys"
              ]
            },
            {
              "required": [
                "redactions"
              ]
            }
          ]
        }
      }
    }
  }
}
