{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Forge-C CRE independent candidate promotion decision",
  "required": [
    "schema_version",
    "decision_id",
    "candidate_sha256",
    "baseline_sha256",
    "policy_sha256",
    "benchmark_sha256",
    "decision",
    "evaluator_id",
    "evaluated_at",
    "hard_gates",
    "reasons"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "baseline_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "benchmark_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decision": {
      "enum": [
        "REJECTED",
        "INCONCLUSIVE",
        "ELIGIBLE_FOR_OFFLINE_REVIEW"
      ]
    },
    "evaluator_id": {
      "type": "string",
      "minLength": 1
    },
    "evaluator_kind": {
      "enum": [
        "INDEPENDENT_DETERMINISTIC_RUNNER",
        "AUTHORIZED_HUMAN"
      ]
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "hard_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "result",
          "evidence_refs"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_RUN"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason_code": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "reproducer_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metrics_snapshot_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_auto_deployment": {
      "const": false
    }
  }
}
