{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge-c/brownfield-workorder/0.1",
  "title": "Delivery block of a brownfield work order spec (examples/<name>/workorder.json -> delivery)",
  "type": "object",
  "required": [
    "code_mode",
    "origin",
    "licence",
    "licence_allows_modification",
    "source",
    "files",
    "scope",
    "build"
  ],
  "additionalProperties": false,
  "properties": {
    "code_mode": {
      "enum": [
        "FROZEN",
        "FIX_ALLOWED"
      ]
    },
    "origin": {
      "type": "string",
      "minLength": 3
    },
    "licence": {
      "type": "string",
      "minLength": 2
    },
    "licence_allows_modification": {
      "type": "boolean"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "pattern": "^software/(ll|hal|src)/[A-Za-z0-9_.-]+\\.(c|h)$"
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "functions"
      ],
      "additionalProperties": false,
      "properties": {
        "functions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "origin",
          "licence"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string",
            "pattern": "^inputs/vendor/include/[A-Za-z0-9_./-]+\\.h$"
          },
          "origin": {
            "type": "string"
          },
          "licence": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "configure": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "hal_modules"
            ],
            "description": "Feature 015 (ST HAL): the dependency is ST's stm32n6xx_hal_conf_template.h configured for this work order - exactly the listed HAL modules enabled (HAL_<MODULE>_MODULE_ENABLED), every other module line commented out; nothing else changes. The template's SHA-256 and the module list are recorded.",
            "properties": {
              "hal_modules": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z0-9]+$"
                }
              }
            }
          }
        }
      }
    },
    "build": {
      "type": "object",
      "required": [
        "style"
      ],
      "additionalProperties": false,
      "properties": {
        "style": {
          "enum": [
            "forge",
            "cmsis"
          ]
        },
        "defines": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,47}(=[A-Za-z0-9_]{1,32})?$"
          }
        },
        "secure": {
          "type": "boolean",
          "description": "cmsis style: build for the secure state (-mcmse; CMSIS selects the secure peripheral aliases, e.g. RCC at 0x56028000)"
        }
      }
    },
    "provided_ll": {
      "type": "boolean",
      "description": "Feature 015 (ST HAL): false for a delivered HAL that accesses the registers itself (ST's classic HAL) - no provided LL work order; default true (the factory's HAL on a provided LL)."
    }
  }
}
