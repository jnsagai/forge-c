+# --- qualification windows (feature 017 T072; owner 2026-11-08: FR-019 option C) -------------------------------------
+# Until the owner approves the cutover, the shared model tier may use the GPU only while the owner lane is stopped as a
+# whole. window-release replays the reviewed deploy chain up to the exact stop, for a candidate whose tree IS the live
+# tree (a same-tree commit, gated like a rollback by rollback_evidence); window-restore is the chain's own fresh-ticket
+# start of that commit. No new authority: the same scripts, receipts and proofs as every deploy. The production observer
+# and lane are never touched. A window costs one deploy slot (rate limit). The branch tip must be the live commit:
+# a same-tree commit on top of a pending candidate would revert it.
+
+def make_same_tree(live_commit, wid):
+    tip = git('rev-parse', BRANCH)
+    need(tip == live_commit, 'WINDOW_REFUSED_PENDING_DEPLOY')
+    tree = git('rev-parse', live_commit + '^{tree}')
+    msg = (f'window: restart the live {live_commit[:8]} tree after qualification window {wid}\n\n'
+           'Generated by the owner-lane deployer (feature 017 T072). The tree is identical to the live revision.\n')
+    name, mail = DEPLOYER[:-1].split(' <')
+    env = dict(os.environ, GIT_AUTHOR_NAME=name, GIT_AUTHOR_EMAIL=mail, GIT_COMMITTER_NAME=name, GIT_COMMITTER_EMAIL=mail)
+    new = subprocess.run(['git', '-C', str(W), 'commit-tree', tree, '-p', tip, '-m', msg], capture_output=True, text=True,
+                         env=env, check=True).stdout.strip()
+    git('update-ref', f'refs/heads/{BRANCH}', new, tip)
+    need(git('rev-parse', new + '^{tree}') == tree, 'WINDOW_TREE')
+    return new
+
+
+def drop_same_tree(rev, live_commit):
+    """An aborted release leaves no trace on the branch: the tip goes back to the live commit (CAS on the tip)."""
+    if rev and git('rev-parse', BRANCH) == rev:
+        git('update-ref', f'refs/heads/{BRANCH}', live_commit, rev)
+
+
