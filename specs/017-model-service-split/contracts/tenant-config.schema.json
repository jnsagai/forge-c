{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge-c/017/tenant-config.schema.json",
  "title": "TenantGatewayConfig",
  "description": "Model-tier tenant gateway configuration. Keys appear only as sha256 hashes. Cross-field rule (checked by the gateway at start): sum(guaranteed_concurrency) <= engine max_sequences, and max_context <= engine context_limit.",
  "type": "object",
  "additionalProperties": false,
  "required": ["engine_url", "engine_key_ref", "identity_lock", "outcome_log", "tenants"],
  "properties": {
    "engine_url": {"type": "string", "description": "internal-network URL of the inference engine; never published"},
    "engine_key_ref": {"type": "string", "description": "name of the secret holding the engine's internal key"},
    "identity_lock": {"type": "string", "description": "path of recipe.lock.json; the gateway refuses to serve on fingerprint mismatch"},
    "outcome_log": {"type": "string"},
    "reasoning_finding_threshold": {"type": "integer", "minimum": 1, "default": 3},
    "tenants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tenant_id", "key_sha256", "guaranteed_concurrency", "max_concurrency", "queue_limit", "queue_timeout_s", "priority", "max_context", "reasoning_mode", "enabled"],
        "properties": {
          "tenant_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,40}$"},
          "key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "guaranteed_concurrency": {"type": "integer", "minimum": 0},
          "max_concurrency": {"type": "integer", "minimum": 1},
          "queue_limit": {"type": "integer", "minimum": 0},
          "queue_timeout_s": {"type": "integer", "minimum": 1},
          "priority": {"type": "integer", "minimum": 0},
          "max_context": {"type": "integer", "minimum": 1},
          "reasoning_mode": {"enum": ["off", "on"]},
          "enabled": {"type": "boolean"}
        }
      }
    }
  }
}
