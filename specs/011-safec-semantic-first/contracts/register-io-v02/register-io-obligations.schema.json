{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-c.local/schemas/register-io-obligations/1:register-io-0.2",
  "title": "Forge-C register-io formal obligations (forge-c/register-io-obligations/2)",
  "description": "The narrow C11/ACSL lowering of a validated register contract: per operation, the pre/post obligations of one call over a register array, their applicability per tool as measured, a C11 reference body, and the obligations that are not lowered. Model: 32-bit register words in plain memory, one thread, no interrupts. Not a proof of any implementation; timing, ordering, concurrency and hardware side effects are not covered.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "contract_semantic_digest",
    "register_array",
    "model",
    "tools",
    "operations",
    "obligations_digest"
  ],
  "properties": {
    "schema": {
      "const": "forge-c/register-io-obligations/2"
    },
    "profile": {
      "const": "register-io-0.2"
    },
    "contract_semantic_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "obligations_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the canonical JSON (sorted keys, no whitespace, UTF-8) of the document without this field."
    },
    "register_array": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,31}$"
    },
    "model": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool",
          "version"
        ],
        "properties": {
          "tool": {
            "enum": [
              "cbmc",
              "frama-c-wp",
              "kind2"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "intent_id",
          "register",
          "field",
          "offset",
          "word",
          "write_kind",
          "obligations",
          "reference_c11",
          "unsupported"
        ],
        "properties": {
          "intent_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "register": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,47}$"
          },
          "field": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,47}$"
          },
          "offset": {
            "type": [
              "string",
              "integer"
            ]
          },
          "word": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4095
          },
          "write_kind": {
            "enum": [
              "none",
              "read_modify_write",
              "full_register_write"
            ]
          },
          "reference_c11": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "obligations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "acsl",
                "applicability"
              ],
              "properties": {
                "id": {
                  "enum": [
                    "RETURN_FIELD",
                    "NO_WRITE",
                    "FIELD_VALUE",
                    "PRESERVED_BITS",
                    "WHOLE_WORD",
                    "FRAME"
                  ]
                },
                "acsl": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "applicability": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "cbmc",
                    "frama-c-wp",
                    "kind2"
                  ],
                  "properties": {
                    "cbmc": {
                      "type": "string",
                      "pattern": "^(SUPPORTED|INCONCLUSIVE|UNSUPPORTED|NOT_APPLICABLE): .{1,300}$"
                    },
                    "frama-c-wp": {
                      "type": "string",
                      "pattern": "^(SUPPORTED|INCONCLUSIVE|UNSUPPORTED|NOT_APPLICABLE): .{1,300}$"
                    },
                    "kind2": {
                      "type": "string",
                      "pattern": "^(SUPPORTED|INCONCLUSIVE|UNSUPPORTED|NOT_APPLICABLE): .{1,300}$"
                    }
                  }
                }
              }
            }
          },
          "unsupported": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "obligation",
                "reason"
              ],
              "properties": {
                "obligation": {
                  "enum": [
                    "KEY_SEQUENCE_ORDER",
                    "HARDWARE_SIDE_EFFECTS",
                    "RESET_AND_TIMING",
                    "CONCURRENCY"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              }
            }
          }
        }
      }
    }
  }
}
