{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forge-c:feature-011:register-io-contract:1",
  "title": "Validated register contract (register-io-0.1), computed by SafeC from a domain and finite intents",
  "description": "Every number here is computed by the engine from domain facts, never taken from a model. semantic_digest is the SHA-256 of the canonical JSON (sorted keys, no whitespace, UTF-8) of the document without semantic_digest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "engine",
    "binding",
    "domain_sha256",
    "operations",
    "coverage",
    "assumptions",
    "unresolved_obligations",
    "properties_checked",
    "semantic_digest"
  ],
  "properties": {
    "schema": {
      "const": "forge-c/register-io-contract/1"
    },
    "profile": {
      "const": "register-io-0.1"
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_commit_sha",
        "binary_sha256",
        "semantic_profile"
      ],
      "properties": {
        "source_commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "binary_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "semantic_profile": {
          "const": "register-io-0.1"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workorder_id",
        "workorder_sha256",
        "source_manifest_sha256",
        "policy_sha256"
      ],
      "properties": {
        "workorder_id": {
          "type": "string"
        },
        "workorder_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "domain_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "intent_id",
          "action",
          "register",
          "field",
          "offset",
          "lsb",
          "msb",
          "width",
          "logical_value",
          "field_mask",
          "encoded_value",
          "access",
          "write_kind",
          "preserved_mask",
          "source_fact_ids",
          "precondition_fact_ids"
        ],
        "properties": {
          "intent_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "action": {
            "enum": [
              "read_field",
              "set_field",
              "clear_field",
              "write_field",
              "write_key_sequence"
            ]
          },
          "register": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "offset": {
            "type": "string",
            "pattern": "^0x[0-9a-f]+$"
          },
          "lsb": {
            "type": "integer"
          },
          "msb": {
            "type": "integer"
          },
          "width": {
            "type": "integer"
          },
          "logical_value": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "field_mask": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{8}$"
          },
          "encoded_value": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^0x[0-9a-f]{8}$"
          },
          "access": {
            "enum": [
              "RO",
              "WO",
              "RW"
            ]
          },
          "write_kind": {
            "enum": [
              "none",
              "read_modify_write",
              "full_register_write"
            ]
          },
          "preserved_mask": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{8}$"
          },
          "source_fact_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "precondition_fact_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "register",
          "field",
          "intent_ids"
        ],
        "properties": {
          "register": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "intent_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 512
      }
    },
    "unresolved_obligations": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 512
      }
    },
    "properties_checked": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "semantic_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
