{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-c.local/schemas/register-io-oracle/1",
  "title": "Forge-C register-io test oracle (forge-c/register-io-oracle/1)",
  "description": "Host register-image expectations derived by the verifier from a validated register contract only (never from a candidate implementation). Each case gives one initial register image and the image and return value the operation must produce. Timing, ordering, concurrency and hardware side effects are not covered.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profile", "contract_semantic_digest", "cases", "limits", "oracle_digest"],
  "properties": {
    "schema": {"const": "forge-c/register-io-oracle/1"},
    "profile": {"const": "register-io-0.1"},
    "contract_semantic_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "oracle_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$",
                      "description": "SHA-256 of the canonical JSON (sorted keys, no whitespace, UTF-8) of the document without this field."},
    "limits": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
    "cases": {
      "type": "array", "minItems": 1, "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["intent_id", "register", "offset", "initial", "expected_after", "expected_return", "writes"],
        "properties": {
          "intent_id": {"type": "string", "minLength": 1, "maxLength": 64},
          "register": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,47}$"},
          "offset": {"type": ["string", "integer"]},
          "initial": {"type": "string", "pattern": "^0x[0-9a-f]{8}$"},
          "expected_after": {"type": "string", "pattern": "^0x[0-9a-f]{8}$"},
          "expected_return": {"type": ["string", "null"], "pattern": "^[0-9]{1,10}$"},
          "writes": {"type": "boolean"}
        }
      }
    }
  }
}
