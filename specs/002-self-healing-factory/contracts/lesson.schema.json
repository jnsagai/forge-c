{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-c.local/specs/v0.4/lesson.schema.json",
  "title": "Forge-C validated lesson",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lesson_id",
    "state",
    "symptoms",
    "root_cause",
    "remedy",
    "evidence_refs",
    "tool_versions",
    "created_at",
    "validation_tests"
  ],
  "properties": {
    "lesson_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "source_incident_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "source_attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "state": {
      "enum": [
        "PROPOSED",
        "QUARANTINED",
        "VALIDATING",
        "VALIDATED",
        "RETRACTED",
        "EXPIRED"
      ]
    },
    "symptoms": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "root_cause": {
      "type": "string",
      "minLength": 1,
      "maxLength": 700
    },
    "remedy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 850
    },
    "constraints": {
      "type": "string",
      "minLength": 0,
      "maxLength": 1200
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "minItems": 1
    },
    "tool_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "validation_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "evidence_ref"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN"
            ]
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      },
      "minItems": 1
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "consumed_by_runs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "source_kind": {
      "enum": [
        "REPAIR_PROMOTED",
        "ORDINARY_OUTCOME",
        "NEGATIVE_OBSERVATION"
      ]
    },
    "contract_version": {
      "const": "2.0"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "experience_ref": {
      "type": "string",
      "pattern": "^experience-[a-f0-9]{24}$"
    },
    "qualification_ref": {
      "type": "string",
      "minLength": 2,
      "maxLength": 200
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phases",
        "roles",
        "targets",
        "source_versions"
      ],
      "properties": {
        "phases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source_kind": {
            "enum": [
              "ORDINARY_OUTCOME",
              "NEGATIVE_OBSERVATION"
            ]
          }
        },
        "required": [
          "source_kind"
        ]
      },
      "then": {
        "required": [
          "contract_version",
          "source_kind",
          "version",
          "experience_ref",
          "qualification_ref",
          "applicability"
        ]
      },
      "else": {
        "required": [
          "source_incident_id",
          "source_attempt_id"
        ]
      }
    }
  ]
}
