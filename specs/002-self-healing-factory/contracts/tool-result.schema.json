{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-c.local/specs/v0.4/tool-result.schema.json",
  "title": "Forge-C MCP tool result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "artifact_refs",
    "issues",
    "provenance"
  ],
  "properties": {
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "UNAVAILABLE",
        "UNSUPPORTED"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 0,
      "maxLength": 160
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "string",
          "boolean",
          "null"
        ]
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "tool",
        "version",
        "invocation_id"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "invocation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "output_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "exit_code": {
          "type": "integer"
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
