{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-c.local/specs/v0.4/token-usage.schema.json",
  "title": "Forge-C token usage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "agent_id",
    "model",
    "basis",
    "tokens_input",
    "tokens_output",
    "budget_total"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "basis": {
      "enum": [
        "reported",
        "estimated",
        "unknown"
      ]
    },
    "tokens_input": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "tokens_output": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "budget_total": {
      "type": "integer",
      "minimum": 0
    },
    "turns": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
