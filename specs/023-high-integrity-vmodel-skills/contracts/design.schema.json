{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge-c-hi/design",
  "title": "Detailed design workproduct (sw-design)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "stage",
    "baseline_id",
    "status",
    "provenance",
    "items",
    "open_points"
  ],
  "properties": {
    "schema": {
      "const": "forge-c-hi/design@1"
    },
    "stage": {
      "enum": [
        "sw-design"
      ]
    },
    "baseline_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "inspected",
        "blocked"
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "role",
        "skill",
        "skill_version",
        "harness",
        "input_hashes",
        "created_utc",
        "run_id"
      ],
      "properties": {
        "role": {
          "enum": [
            "author",
            "inspector",
            "release",
            "intake",
            "gate"
          ]
        },
        "skill": {
          "type": "string"
        },
        "skill_version": {
          "type": "string"
        },
        "harness": {
          "type": "string"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_family": {
          "type": [
            "string",
            "null"
          ]
        },
        "input_hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "created_utc": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "sources",
          "files",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SWU-[A-Z0-9_]+-[0-9]{3}$"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "minLength": 10
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "kind",
                    "id"
                  ],
                  "properties": {
                    "kind": {
                      "const": "upstream"
                    },
                    "id": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "kind",
                    "doc_id",
                    "section",
                    "page"
                  ],
                  "properties": {
                    "kind": {
                      "const": "document"
                    },
                    "doc_id": {
                      "type": "string"
                    },
                    "section": {
                      "type": "string",
                      "maxLength": 32
                    },
                    "page": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(src|include)/[A-Za-z0-9_./-]+\\.(c|h)$"
            }
          },
          "functions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "behaviour"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "signature": {
                  "type": "string"
                },
                "behaviour": {
                  "type": "string"
                }
              }
            }
          },
          "attributes": {
            "type": "object"
          },
          "status": {
            "enum": [
              "proposed",
              "accepted-by-inspection",
              "open",
              "rejected"
            ]
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "open_points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "blocks"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "raised_by": {
            "type": "string"
          },
          "blocks": {
            "type": "boolean"
          },
          "deferred_to": {
            "type": "string",
            "enum": [
              "sys-req",
              "sys-arch",
              "sw-req",
              "sw-arch",
              "sw-design",
              "unit-verif",
              "sw-integ",
              "sw-qual",
              "sys-integ",
              "sys-qual"
            ],
            "description": "Non-blocking open point: the later stage that owns the detail and must close it."
          },
          "returned_to": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "sys-req",
              "sys-arch",
              "sw-req",
              "sw-arch",
              "sw-design",
              "unit-verif",
              "sw-integ",
              "sw-qual",
              "sys-integ",
              "sys-qual",
              null
            ],
            "description": "Blocking open point after the first stage: the earlier stage whose workproduct must change to settle it, or null when only a person can decide."
          }
        }
      }
    }
  }
}
